{
  "id": "L21-rising-run",
  "level": 21,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 3,
  "title": "Rising Run",
  "statement": "A runner's daily distances are listed in order. Pick some days (not necessarily next to each other, keeping their order) so that each picked distance is strictly greater than the one before. Return the most days you can pick.",
  "examples": [
    {
      "input": "distances = [10, 9, 2, 5, 3, 7, 101, 18]",
      "output": "4"
    },
    {
      "input": "distances = [7, 7, 7]",
      "output": "1"
    }
  ],
  "constraints": [
    "1 <= distances.length <= 1000",
    "1 <= distances[i] <= 10^4"
  ],
  "answerKey": {
    "pattern": "1-D DP: len(i) = 1 + max len(j) over j < i with distances[j] < distances[i]",
    "keyPoints": [
      "len(i) is the longest rising run that ends on day i",
      "Look at every earlier smaller day",
      "The answer is the largest len(i)"
    ],
    "timeComplexity": "O(n²)",
    "spaceComplexity": "O(n)",
    "edgeCases": [
      "One day",
      "All equal: 1",
      "Strictly decreasing: 1"
    ],
    "acceptableSlowerApproaches": [
      "Try every subset: O(2^n)",
      "Patience sorting with binary search: O(n log n), faster"
    ]
  },
  "hints": [
    "Define the answer for a run that must end on day i.",
    "len(i) = 1 + the best len(j) among earlier days j with a smaller distance.",
    "Two loops over i and j < i; return the maximum."
  ],
  "starterCode": {
    "javascript": "function risingRun(distances) {\n  // return the longest rising run\n}",
    "java": "class Solution {\n  int risingRun(int[] distances) {\n    // return the longest rising run\n  }\n}"
  },
