{
  "id": "L21-grid-routes",
  "level": 21,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 2,
  "title": "Grid Routes",
  "statement": "A delivery robot starts at the top-left cell of a grid and must reach the bottom-right cell, moving only right or down. Cells with 1 are blocked. Return the number of different routes. The answer fits in a 32-bit integer.",
  "examples": [
    {
      "input": "grid = [[0, 0, 0], [0, 1, 0], [0, 0, 0]]",
      "output": "2"
    },
    {
      "input": "grid = [[0, 1], [0, 0]]",
      "output": "1"
    }
  ],
  "constraints": [
    "1 <= rows, columns <= 30",
    "grid[r][c] is 0 or 1",
    "The answer is below 2^31"
  ],
  "answerKey": {
    "pattern": "2-D DP: routes(r, c) = routes(r − 1, c) + routes(r, c − 1), 0 on blocked cells",
    "keyPoints": [
      "routes(0, 0) = 1 unless blocked",
      "A cell is reached from above or from the left",
      "A blocked cell has 0 routes; one row of values is enough"
    ],
    "timeComplexity": "O(rows · columns)",
    "spaceComplexity": "O(columns)",
    "edgeCases": [
      "Start or end blocked: 0",
      "One row or one column",
      "A wall that cuts every route"
    ],
    "acceptableSlowerApproaches": [
      "Count every path with DFS: exponential"
    ]
  },
  "hints": [
    "How can the robot arrive at cell (r, c)?",
    "From above or from the left, so add those two counts.",
    "Use one array row[c]; for each cell: row[c] = blocked ? 0 : row[c] + row[c − 1]."
  ],
  "starterCode": {
    "javascript": "function gridRoutes(grid) {\n  // return the number of routes\n}",
    "java": "class Solution {\n  int gridRoutes(int[][] grid) {\n    // return the number of routes\n  }\n}"
  },
