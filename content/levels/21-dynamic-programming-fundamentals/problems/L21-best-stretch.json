{
  "id": "L21-best-stretch",
  "level": 21,
  "difficulty": "Easy",
  "use": "test",
  "status": "ready",
  "title": "Best Stretch",
  "statement": "A shop's daily profit (possibly negative) is listed in order. Return the largest total profit over a run of one or more consecutive days.",
  "examples": [
    {
      "input": "profit = [-2, 1, -3, 4, -1, 2, 1, -5, 4]",
      "output": "6"
    },
    {
      "input": "profit = [-3, -1, -2]",
      "output": "-1"
    }
  ],
  "constraints": [
    "1 <= profit.length <= 10^4",
    "-10^4 <= profit[i] <= 10^4"
  ],
  "answerKey": {
    "pattern": "Kadane's DP: best ending at i = max(profit[i], best ending at i − 1 + profit[i])",
    "keyPoints": [
      "Either start a new run at day i or extend the run ending at i − 1",
      "Track the best value seen",
      "All negative: the largest single day"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "One day",
      "All negative",
      "All positive: the whole list"
    ],
    "acceptableSlowerApproaches": [
      "Check every start and end: O(n²)"
    ]
  },
  "hints": [
    "Define the best run that must end on day i.",
    "It either starts fresh on day i or extends the best run ending on day i − 1.",
    "cur = max(p, cur + p); best = max(best, cur)."
  ],
  "starterCode": {
    "javascript": "function bestStretch(profit) {\n  // return the largest run total\n}",
    "java": "class Solution {\n  int bestStretch(int[] profit) {\n    // return the largest run total\n  }\n}"
  },
