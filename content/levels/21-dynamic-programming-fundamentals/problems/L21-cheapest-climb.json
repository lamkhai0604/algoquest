  "status": "ready",
  "order": 3,
  "title": "Cheapest Climb",
  "statement": "Each stair i has a fee fee[i] that you pay when you stand on it. You may start on stair 0 or stair 1, and each move climbs 1 or 2 stairs. The top is just past the last stair. Return the smallest total fee to reach the top.",
  "examples": [
    {
      "input": "fee = [10, 15, 20]",
      "output": "15"
    },
    {
      "input": "fee = [1, 100, 1, 1, 1, 100, 1, 1, 100, 1]",
      "output": "6"
    }
  ],
  "constraints": [
    "2 <= fee.length <= 1000",
    "0 <= fee[i] <= 999"
  ],
  "answerKey": {
    "pattern": "1-D DP: cost(i) = fee[i] + min(cost(i − 1), cost(i − 2))",
    "keyPoints": [
      "cost(i) is the cheapest way to stand on stair i",
      "The top is reached from one of the last two stairs",
      "Rolling two values gives O(1) space"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "Two stairs",
      "All fees zero",
      "Big fees in a pattern"
    ],
    "acceptableSlowerApproaches": [
      "Recursion over every path: O(2^n)"
    ]
  },
  "hints": [
    "What is the cheapest way to stand on stair i?",
    "You came from stair i − 1 or i − 2, so cost(i) = fee[i] + the cheaper of those.",
    "Answer = min(cost(n − 1), cost(n − 2))."
  ],
  "starterCode": {
    "javascript": "function cheapestClimb(fee) {\n  // return the smallest total fee\n}",
    "java": "class Solution {\n  int cheapestClimb(int[] fee) {\n    // return the smallest total fee\n  }\n}"
  },
