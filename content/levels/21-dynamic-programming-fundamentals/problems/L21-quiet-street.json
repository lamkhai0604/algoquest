{
  "id": "L21-quiet-street",
  "level": 21,
  "difficulty": "Easy",
  "use": "practice",
  "status": "ready",
  "order": 2,
  "title": "Quiet Street",
  "statement": "Houses stand in a row, and house i has a donation of gifts[i]. A volunteer may visit any houses, but never two neighbours in a row, so the street stays quiet. Return the largest total of donations.",
  "examples": [
    {
      "input": "gifts = [2, 7, 9, 3, 1]",
      "output": "12"
    },
    {
      "input": "gifts = [1, 2, 3, 1]",
      "output": "4"
    }
  ],
  "constraints": [
    "1 <= gifts.length <= 1000",
    "0 <= gifts[i] <= 1000"
  ],
  "answerKey": {
    "pattern": "1-D DP: best(i) = max(best(i − 1), best(i − 2) + gifts[i])",
    "keyPoints": [
      "Either skip house i (keep best(i − 1)) or take it (best(i − 2) + gifts[i])",
      "Two rolling values are enough",
      "Answer is best of the last house"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "One house",
      "Two houses: the larger one",
      "All zeros"
    ],
    "acceptableSlowerApproaches": [
      "Try every set of non-neighbours: O(2^n)"
    ]
  },
  "hints": [
    "For the last house, you either visit it or you don't.",
    "If you visit house i, house i − 1 is off limits.",
    "best = max(best without i, best up to i − 2 + gifts[i]); keep two running values."
  ],
  "starterCode": {
    "javascript": "function quietStreet(gifts) {\n  // return the largest total\n}",
    "java": "class Solution {\n  int quietStreet(int[] gifts) {\n    // return the largest total\n  }\n}"
  },
