  {
    "title": "The task",
    "body": "Six courses; an arrow a → b means **a before b**. Count the arrows into each course (its in-degree). Courses 0 and 1 have none, so they can go first and wait in the queue.",
    "code": "function courseOrder(n, edges) {\n  const indegree = new Array(n).fill(0);\n  const out = Array.from({ length: n }, () => []);\n  for (const [a, b] of edges) {\n    out[a].push(b);\n    indegree[b]++;\n  }\n  const queue = [];\n  for (let v = 0; v < n; v++) if (indegree[v] === 0) queue.push(v);\n  const order = [];\n  while (queue.length > 0) {\n    const v = queue.shift();\n    order.push(v);\n    for (const w of out[v])\n      if (--indegree[w] === 0) queue.push(w);\n  }\n  return order.length === n ? order : [];\n}",
