{
  "id": "L18-maze-exit",
  "level": 18,
  "difficulty": "Easy",
  "use": "practice",
  "status": "ready",
  "order": 1,
  "title": "Maze Exit",
  "statement": "A maze is a grid where 0 is open floor and 1 is a wall. Starting in the top-left cell, moving up, down, left or right, return the fewest moves to reach the bottom-right cell, or −1 if it cannot be reached.",
  "examples": [
    {
      "input": "maze = [[0, 0, 0], [1, 1, 0], [0, 0, 0]]",
      "output": "4"
    },
    {
      "input": "maze = [[0, 1], [1, 0]]",
      "output": "-1"
    }
  ],
  "constraints": [
    "1 <= rows, cols <= 30",
    "maze[r][c] is 0 or 1; the corners are 0"
  ],
  "answerKey": {
    "pattern": "BFS on a grid",
    "keyPoints": [
      "Start BFS at the top-left with distance 0",
      "Visit the four neighbours that are open and not yet seen",
      "Distance + 1 for each new cell; mark when queued",
      "Return the distance of the bottom-right cell, or −1"
    ],
    "timeComplexity": "O(R · C)",
    "spaceComplexity": "O(R · C)",
    "edgeCases": [
      "A 1 × 1 maze: 0",
      "No path",
      "Long winding paths"
    ],
    "acceptableSlowerApproaches": [
      "DFS over every path, keeping the shortest: exponential"
    ]
  },
  "hints": [
    "Every move costs the same. Which search finds the fewest moves?",
    "BFS from the start, with a distance per cell.",
    "Mark cells when they join the queue so none is added twice; stop when the exit comes out of the queue."
  ],
  "starterCode": {
    "javascript": "function mazeExit(maze) {\n  // return the fewest moves, or -1\n}",
    "java": "class Solution {\n  int mazeExit(int[][] maze) {\n    // return the fewest moves, or -1\n  }\n}"
  },
