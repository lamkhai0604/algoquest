{
  "id": "L18-route-count",
  "level": 18,
  "difficulty": "Easy",
  "use": "practice",
  "status": "ready",
  "order": 3,
  "title": "Route Count",
  "statement": "A hiking map has n checkpoints, 0 to n − 1, and one-way trails trails[i] = [a, b] from a to b. The trails never lead back to an earlier checkpoint, so there are no loops. Return how many different routes go from checkpoint 0 to checkpoint n − 1.",
  "examples": [
    {
      "input": "n = 4, trails = [[0, 1], [0, 2], [1, 3], [2, 3]]",
      "output": "2"
    },
    {
      "input": "n = 3, trails = [[0, 1]]",
      "output": "0"
    }
  ],
  "constraints": [
    "2 <= n <= 60",
    "The trails form no loop",
    "The answer fits in a 32-bit integer"
  ],
  "answerKey": {
    "pattern": "DFS with memoisation on a directed acyclic graph",
    "keyPoints": [
      "routes(v) = 1 if v is the last checkpoint",
      "Otherwise routes(v) = sum of routes(w) over trails v → w",
      "Remember each routes(v) so it is computed once"
    ],
    "timeComplexity": "O(V + E)",
    "spaceComplexity": "O(V)",
    "edgeCases": [
      "No route",
      "Many routes sharing parts",
      "n = 2"
    ],
    "acceptableSlowerApproaches": [
      "DFS over every route without memoisation: exponential in the worst case"
    ]
  },
  "hints": [
    "Routes from 0 are made of a first trail and then a route from the next checkpoint.",
    "routes(v) = sum of routes(w) over the trails out of v, and routes(n − 1) = 1.",
    "Without loops this recursion ends; remember each result so shared parts are counted once."
  ],
  "starterCode": {
    "javascript": "function routeCount(n, trails) {\n  // return the number of routes from 0 to n - 1\n}",
    "java": "class Solution {\n  int routeCount(int n, int[][] trails) {\n    // return the number of routes from 0 to n - 1\n  }\n}"
  },
