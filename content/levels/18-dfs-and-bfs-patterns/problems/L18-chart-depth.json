  "difficulty": "Easy",
  "use": "test",
  "status": "ready",
  "title": "Org Chart Depth",
  "statement": "A company has n people, 0 to n − 1. manager[i] is the manager of person i, or −1 for the one person at the top. Return the number of levels in the org chart (the top person alone is 1 level).",
  "examples": [
    {
      "input": "manager = [-1, 0, 0, 1]",
      "output": "3"
    },
    {
      "input": "manager = [-1]",
      "output": "1"
    }
  ],
  "constraints": [
    "1 <= n <= 100000",
    "Exactly one −1; the chart is a tree"
  ],
  "answerKey": {
    "pattern": "BFS by levels on a tree built from a parent array",
    "keyPoints": [
      "Build each manager's list of direct reports",
      "BFS from the top person, one level at a time",
      "Count the levels"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(n)",
    "edgeCases": [
      "One person",
      "A single chain",
      "A very wide first level"
    ],
    "acceptableSlowerApproaches": [
      "For each person, walk up to the top and take the longest walk: O(n · depth)"
    ]
  },
  "hints": [
    "The array gives each person's manager. Which direction do you need to walk the chart from the top?",
    "Turn it around: list each manager's reports.",
    "BFS from the top person level by level, or DFS for the maximum depth."
  ],
  "starterCode": {
