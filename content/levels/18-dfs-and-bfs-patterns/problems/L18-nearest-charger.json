{
  "id": "L18-nearest-charger",
  "level": 18,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 2,
  "title": "Nearest Charger",
  "statement": "An office floor is a grid: 1 is a charging point, 0 is open floor, −1 is a wall. For every cell, return the fewest steps (up, down, left, right, through open floor or chargers) to the nearest charger. Walls, and cells that cannot reach any charger, get −1; chargers get 0.",
  "examples": [
    {
      "input": "floor = [[0, 0, 1], [0, -1, 0], [0, 0, 0]]",
      "output": "[[2, 1, 0], [3, -1, 1], [4, 3, 2]]"
    },
    {
      "input": "floor = [[0, -1, 1]]",
      "output": "[[-1, -1, 0]]"
    }
  ],
  "constraints": [
    "1 <= rows, cols <= 30"
  ],
  "answerKey": {
    "pattern": "Multi-source BFS",
    "keyPoints": [
      "Put every charger in the queue at distance 0",
      "BFS outward through non-wall cells",
      "The first time a cell is reached is from its nearest charger",
      "Everything else stays −1"
    ],
    "timeComplexity": "O(R · C)",
    "spaceComplexity": "O(R · C)",
    "edgeCases": [
      "No chargers",
      "Walls enclosing an area",
      "Every cell a charger"
    ],
    "acceptableSlowerApproaches": [
      "BFS from each charger, keeping the minimum: O(k · R · C)"
    ]
  },
  "hints": [
    "Running one search per charger repeats work. What if all chargers start together?",
    "Put all chargers in one queue at distance 0.",
    "BFS from that queue fills each cell with its distance to the nearest charger."
  ],
  "starterCode": {
    "javascript": "function nearestCharger(floor) {\n  // return the distance grid\n}",
    "java": "class Solution {\n  int[][] nearestCharger(int[][] floor) {\n    // return the distance grid\n  }\n}"
  },
