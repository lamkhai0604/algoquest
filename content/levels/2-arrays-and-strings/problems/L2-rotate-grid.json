{
  "id": "L2-rotate-grid",
  "level": 2,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 3,
  "title": "Turn the Photo",
  "statement": "A square photo is stored as an n × n grid of pixel values: grid[row][col]. Return a new grid that shows the photo turned 90 degrees clockwise.",
  "examples": [
    {
      "input": "[[1, 2], [3, 4]]",
      "output": "[[3, 1], [4, 2]]"
    },
    {
      "input": "[[1, 2, 3], [4, 5, 6], [7, 8, 9]]",
      "output": "[[7, 4, 1], [8, 5, 2], [9, 6, 3]]"
    }
  ],
  "constraints": [
    "0 <= n <= 100",
    "grid is square: every row has n values"
  ],
  "answerKey": {
    "pattern": "2D index mapping: the pixel at (r, c) moves to (c, n - 1 - r)",
    "keyPoints": [
      "Create an n × n result grid",
      "For every row r and column c, copy grid[r][c] into result[c][n - 1 - r]",
      "Check the formula on a corner: the top-left pixel goes to the top-right corner",
      "Return the result"
    ],
    "timeComplexity": "O(n²), one step per pixel",
    "spaceComplexity": "O(n²) for the new grid",
    "edgeCases": [
      "Empty grid returns []",
      "1 × 1 grid stays the same",
      "Mixing up rows and columns turns the photo the wrong way"
    ],
    "acceptableSlowerApproaches": [
      "Transpose then reverse each row: also O(n²), an equally good answer and the usual in-place method"
    ]
  },
  "hints": [
    "Draw a 3 × 3 grid with numbers 1-9 and its turned version. Where does each corner go?",
    "The first row of the photo becomes the last column. In general, the pixel at row r, column c ends up in row c.",
    "Its new column is n - 1 - r. Copy every pixel with result[c][n - 1 - r] = grid[r][c]."
  ],
  "starterCode": {
    "javascript": "function rotateGrid(grid) {\n  // return the grid turned 90 degrees clockwise\n}",
    "java": "class Solution {\n  int[][] rotateGrid(int[][] grid) {\n    // return the grid turned 90 degrees clockwise\n  }\n}"
  },
  "similarLeetCode": "Rotate Image",
