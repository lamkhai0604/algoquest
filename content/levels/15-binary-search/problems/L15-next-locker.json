{
  "id": "L15-next-locker",
  "level": 15,
  "difficulty": "Easy",
  "use": "test",
  "status": "ready",
  "title": "Next Locker Letter",
  "statement": "Lockers are labelled with letters, listed in sorted order (labels can repeat). For a given letter, return the smallest label strictly greater than it; if there is none, wrap around and return the first label.",
  "examples": [
    {
      "input": "labels = [\"c\", \"f\", \"j\"], letter = \"a\"",
      "output": "\"c\""
    },
    {
      "input": "labels = [\"c\", \"f\", \"j\"], letter = \"j\"",
      "output": "\"c\""
    }
  ],
  "constraints": [
    "2 <= labels.length <= 100000",
    "labels is sorted, lowercase letters"
  ],
  "answerKey": {
    "pattern": "Upper bound with wrap-around",
    "keyPoints": [
      "Find the first index with labels[i] > letter (upper bound)",
      "If it is past the end, return labels[0]",
      "Otherwise return labels[index]"
    ],
    "timeComplexity": "O(log n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "Every label is smaller or equal: wrap around",
      "Repeated labels",
      "The letter is not among the labels"
    ],
    "acceptableSlowerApproaches": [
      "Scan for the first greater label: O(n)"
    ]
  },
  "hints": [
    "You need the first label strictly greater than the letter. Which bound is that?",
    "The upper bound: the first index with a value > letter.",
    "If the upper bound is n, wrap around to index 0."
  ],
  "starterCode": {
    "javascript": "function nextLocker(labels, letter) {\n  // return the next label\n}",
    "java": "class Solution {\n  char nextLocker(char[] labels, char letter) {\n    // return the next label\n  }\n}"
  },
  "similarLeetCode": "Find Smallest Letter Greater Than Target",
