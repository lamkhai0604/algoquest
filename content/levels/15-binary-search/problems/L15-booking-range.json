{
  "id": "L15-booking-range",
  "level": 15,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 1,
  "title": "Booking Range",
  "statement": "A hotel keeps its booking dates as day numbers in a sorted list (a day appears once per booking). For a given day, return [first, last]: the first and last positions of that day in the list, or [-1, -1] if no booking has that day. Use O(log n) time.",
  "examples": [
    {
      "input": "days = [5, 7, 7, 8, 8, 10], day = 8",
      "output": "[3, 4]"
    },
    {
      "input": "days = [5, 7, 7, 8, 8, 10], day = 6",
      "output": "[-1, -1]"
    }
  ],
  "constraints": [
    "0 <= days.length <= 100000",
    "days is sorted ascending"
  ],
  "answerKey": {
    "pattern": "Two binary searches: lower and upper bound",
    "keyPoints": [
      "Lower bound: first index with days[i] >= day",
      "Upper bound: first index with days[i] > day",
      "If the lower bound is past the end or holds a different day, return [-1, -1]",
      "Otherwise return [lower, upper − 1]"
    ],
    "timeComplexity": "O(log n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "Empty list",
      "The day appears once",
      "The whole list is that day"
    ],
    "acceptableSlowerApproaches": [
      "Find one copy, then scan left and right: O(n) in the worst case"
    ]
  },
  "hints": [
    "Finding one copy is easy. Where exactly do the copies start and end?",
    "The start is the first index with a value >= day; the end is just before the first index with a value > day.",
    "Write one lower-bound search and call it for day and for day + 1."
  ],
  "starterCode": {
    "javascript": "function bookingRange(days, day) {\n  // return [first, last] or [-1, -1]\n}",
    "java": "class Solution {\n  int[] bookingRange(int[] days, int day) {\n    // return {first, last} or {-1, -1}\n  }\n}"
  },
