{
  "id": "L15-reading-pace",
  "level": 15,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 3,
  "title": "Reading Pace",
  "statement": "A student must finish a list of books within h hours. Each hour she reads up to k pages from one book; if the book has fewer pages left, she finishes it and rests for the rest of that hour. Return the smallest whole k that finishes every book within h hours.",
  "examples": [
    {
      "input": "pages = [3, 6, 7, 11], h = 8",
      "output": "4"
    },
    {
      "input": "pages = [30, 11, 23, 4, 20], h = 5",
      "output": "30"
    }
  ],
  "constraints": [
    "1 <= pages.length <= h <= 10^9",
    "1 <= pages[i] <= 10^9"
  ],
  "answerKey": {
    "pattern": "Binary search on the answer",
    "keyPoints": [
      "The answer is between 1 and the largest book",
      "hours(k) = sum of ceil(pages[i] / k) shrinks as k grows",
      "Find the smallest k with hours(k) <= h",
      "Count hours in 64 bits"
    ],
    "timeComplexity": "O(n log max)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "h equals the number of books: k is the largest book",
      "Very large h: k = 1",
      "One book"
    ],
    "acceptableSlowerApproaches": [
      "Try k = 1, 2, 3, …: O(n · max)"
    ]
  },
  "hints": [
    "If a pace k is fast enough, is every faster pace also fast enough?",
    "Yes, so the check flips once: binary search over k from 1 to the largest book.",
    "For each mid, add up ceil(pages / mid) hours; if it fits in h, try smaller, else larger."
  ],
  "starterCode": {
    "javascript": "function readingPace(pages, h) {\n  // return the smallest pace k\n}",
    "java": "class Solution {\n  int readingPace(int[] pages, int h) {\n    // return the smallest pace k\n  }\n}"
  },
