{
  "id": "L15-first-broken",
  "level": 15,
  "difficulty": "Easy",
  "use": "practice",
  "status": "ready",
  "order": 1,
  "title": "First Broken Build",
  "statement": "A build history is a list of 0s and 1s in order: 0 means the build passed, 1 means it failed. Once a build fails, every later build also fails. Return the index of the first failed build, or −1 if none failed. Use O(log n) checks.",
  "examples": [
    {
      "input": "builds = [0, 0, 0, 1, 1]",
      "output": "3"
    },
    {
      "input": "builds = [0, 0]",
      "output": "-1"
    }
  ],
  "constraints": [
    "1 <= builds.length <= 100000",
    "builds is some 0s followed by some 1s"
  ],
  "answerKey": {
    "pattern": "Binary search for the first position where a condition holds",
    "keyPoints": [
      "lo = 0, hi = n",
      "If builds[mid] is 1, the first failure is at mid or earlier: hi = mid",
      "Otherwise it is later: lo = mid + 1",
      "lo == n means no failure"
    ],
    "timeComplexity": "O(log n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "No failures",
      "All failed",
      "One build"
    ],
    "acceptableSlowerApproaches": [
      "Scan from the start: O(n)"
    ]
  },
  "hints": [
    "The list is passes, then failures. What does one look at the middle tell you?",
    "If the middle failed, the first failure is there or to its left; if it passed, it is to its right.",
    "Keep lo..hi containing the answer, with hi = n meaning \"none\"; loop while lo < hi."
  ],
  "starterCode": {
    "javascript": "function firstBroken(builds) {\n  // return the first failed index, or -1\n}",
    "java": "class Solution {\n  int firstBroken(int[] builds) {\n    // return the first failed index, or -1\n  }\n}"
  },
