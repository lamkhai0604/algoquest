      "input": "heights = [0, 10, 5]",
      "output": "1"
    }
  ],
  "constraints": [
    "3 <= heights.length <= 100000",
    "Strictly up, then strictly down, with the summit not at either end"
  ],
  "answerKey": {
    "pattern": "Binary search on a slope",
    "keyPoints": [
      "Compare heights[mid] with heights[mid + 1]",
      "Rising: the summit is to the right, lo = mid + 1",
      "Falling: the summit is mid or to the left, hi = mid",
      "Stop when lo == hi"
    ],
    "timeComplexity": "O(log n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "Summit next to the start",
      "Summit next to the end",
      "Length 3"
    ],
    "acceptableSlowerApproaches": [
      "Scan for the largest height: O(n)"
    ]
  },
  "hints": [
    "The array is not sorted, but each half is. What does the slope at mid tell you?",
    "If the trail rises at mid, the summit is to the right; if it falls, it is at mid or to the left.",
    "lo = 0, hi = n − 1; while lo < hi: compare heights[mid] and heights[mid + 1]."
  ],
