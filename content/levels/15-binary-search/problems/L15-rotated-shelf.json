  "level": 15,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 2,
  "title": "Rotated Shelf",
  "statement": "A shelf of books was sorted by ID, then someone moved a block from the front to the back, so the IDs are sorted but rotated (for example [40, 50, 10, 20, 30]). All IDs are different. Return the position of a given ID, or −1, using O(log n) looks.",
  "examples": [
    {
      "input": "ids = [40, 50, 10, 20, 30], id = 20",
      "output": "3"
    },
    {
      "input": "ids = [40, 50, 10, 20, 30], id = 35",
      "output": "-1"
    }
  ],
  "constraints": [
    "1 <= ids.length <= 100000",
    "All IDs are different"
  ],
  "answerKey": {
    "pattern": "Binary search with a sorted half",
    "keyPoints": [
      "At each mid, one half (lo..mid or mid..hi) is sorted",
      "Check whether the target lies within the sorted half's range",
      "If yes, search that half; otherwise search the other half"
    ],
    "timeComplexity": "O(log n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "Not rotated at all",
      "Rotated by one",
      "One book"
    ],
    "acceptableSlowerApproaches": [
      "Find the rotation point, then binary search the right part: also O(log n)",
      "Scan: O(n)"
    ]
  },
  "hints": [
    "Split the shelf at mid. Can both halves be out of order at once?",
    "No: at least one half is sorted, and you can check its ends.",
    "If the target is between the sorted half's first and last value, go there; otherwise go to the other half."
  ],
  "starterCode": {
    "javascript": "function findBook(ids, id) {\n  // return the position, or -1\n}",
    "java": "class Solution {\n  int findBook(int[] ids, int id) {\n    // return the position, or -1\n  }\n}"
  },
