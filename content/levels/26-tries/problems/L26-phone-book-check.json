{
  "id": "L26-phone-book-check",
  "level": 26,
  "difficulty": "Easy",
  "use": "practice",
  "status": "ready",
  "order": 3,
  "title": "Phone Book Check",
  "statement": "A phone book lists distinct numbers as strings of digits. Dialling stops as soon as the digits typed match a full number. Return true if every number can be dialled, that is, no number is a prefix of another number.",
  "examples": [
    {
      "input": "numbers = [\"911\", \"97625999\", \"91125426\"]",
      "output": "false"
    },
    {
      "input": "numbers = [\"113\", \"12340\", \"123440\", \"12345\", \"98346\"]",
      "output": "true"
    }
  ],
  "constraints": [
    "1 <= numbers.length <= 10^4",
    "1 <= numbers[i].length <= 10",
    "numbers are distinct"
  ],
  "answerKey": {
    "pattern": "Insert into a trie and fail when a path passes an end mark or ends inside another number",
    "keyPoints": [
      "While inserting, if you walk through a node that ends a number, a shorter number is a prefix",
      "If the new number ends at a node that already has children, it is a prefix of a longer one",
      "Otherwise mark the end"
    ],
    "timeComplexity": "O(total digits)",
    "spaceComplexity": "O(total digits)",
    "edgeCases": [
      "One number",
      "A number that is a prefix of a later one",
      "A number that has an earlier one as prefix"
    ],
    "acceptableSlowerApproaches": [
      "Compare every pair: O(n² · L)",
      "Sort, then compare only neighbours: O(n log n · L), also fine"
    ]
  },
  "hints": [
    "Where in a trie would one number being a prefix of another show up?",
    "Either an end mark on the path of a longer number, or a number ending where other numbers continue.",
    "Check both cases while inserting each number."
  ],
  "starterCode": {
    "javascript": "function phoneBookCheck(numbers) {\n  // return whether no number is a prefix of another\n}",
    "java": "class Solution {\n  boolean phoneBookCheck(String[] numbers) {\n    // return whether no number is a prefix of another\n  }\n}"
  },
  "similarLeetCode": "Phone List (prefix check)",
