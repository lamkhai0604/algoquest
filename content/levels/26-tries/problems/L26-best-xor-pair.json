  "order": 3,
  "title": "Best XOR Pair",
  "statement": "A radio uses pairs of channel codes. The interference between two codes is their bitwise XOR. Given a list of non-negative codes, return the largest XOR of any two of them (a code with itself counts, giving 0).",
  "examples": [
    {
      "input": "codes = [3, 10, 5, 25, 2, 8]",
      "output": "28"
    },
    {
      "input": "codes = [14, 70, 53, 83, 49, 91, 36, 80, 92, 51, 66, 70]",
      "output": "127"
    }
  ],
  "constraints": [
    "1 <= codes.length <= 2 * 10^4",
    "0 <= codes[i] < 2^31"
  ],
  "answerKey": {
    "pattern": "A binary trie of the codes, read from the highest bit; for each code, walk towards the opposite bit",
    "keyPoints": [
      "Insert every code bit by bit from bit 30 down to 0",
      "For a code, at each bit try the child with the opposite bit; it adds that bit to the XOR",
      "The best result over all codes is the answer"
    ],
    "timeComplexity": "O(n · 31)",
    "spaceComplexity": "O(n · 31)",
    "edgeCases": [
      "One code: 0",
      "All codes equal: 0",
      "Codes near 2³¹"
    ],
    "acceptableSlowerApproaches": [
      "Try every pair: O(n²)"
    ]
  },
  "hints": [
    "Which bit of a XOR matters most?",
    "The highest one: winning it beats every lower bit together. So decide bits from the top.",
    "Binary trie; for each code, greedily prefer the opposite bit at every level."
  ],
  "starterCode": {
    "javascript": "function bestXorPair(codes) {\n  // return the largest XOR\n}",
    "java": "class Solution {\n  int bestXorPair(int[] codes) {\n    // return the largest XOR\n  }\n}"
  },
