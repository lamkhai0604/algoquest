{
  "id": "L26-wildcard-dictionary",
  "level": 26,
  "difficulty": "Medium",
  "use": "test",
  "status": "ready",
  "title": "Wildcard Dictionary",
  "statement": "A crossword helper stores a list of words. Each query is a pattern where a dot matches any one letter. For each query, return true if some stored word has the same length and matches the pattern.",
  "examples": [
    {
      "input": "words = [\"bad\", \"dad\", \"mad\"], queries = [\"pad\", \"bad\", \".ad\", \"b..\"]",
      "output": "[false, true, true, true]"
    },
    {
      "input": "words = [\"a\"], queries = [\".\", \"..\"]",
      "output": "[true, false]"
    }
  ],
  "constraints": [
    "1 <= words.length <= 10^4",
    "1 <= queries.length <= 10^4",
    "1 <= length <= 25",
    "patterns have at most 3 dots"
  ],
  "answerKey": {
    "pattern": "A trie of words; search with DFS that tries every child on a dot",
    "keyPoints": [
      "Insert every word with an end mark",
      "For a letter, follow that child; for a dot, try every child",
      "Match only when the pattern ends exactly at an end mark"
    ],
    "timeComplexity": "O(total letters) to build; a query is O(26^dots · L)",
    "spaceComplexity": "O(total letters)",
    "edgeCases": [
      "Pattern longer than every word",
      "All dots",
      "A word that is a prefix of another"
    ],
    "acceptableSlowerApproaches": [
      "Compare each query with every word: O(q · n · L)"
    ]
  },
  "hints": [
    "How does a trie handle a normal letter, and what changes for a dot?",
    "A letter has one child to follow; a dot means any child might lead to a match.",
    "Recursive search(node, i): on '.', loop over all children; return true at the end only if the node ends a word."
  ],
  "starterCode": {
    "javascript": "function wildcardDictionary(words, queries) {\n  // return whether each pattern matches a word\n}",
    "java": "class Solution {\n  boolean[] wildcardDictionary(String[] words, String[] queries) {\n    // return whether each pattern matches a word\n  }\n}"
  },
  "similarLeetCode": "Design Add and Search Words Data Structure",
