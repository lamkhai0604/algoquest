  "use": "practice",
  "status": "ready",
  "order": 2,
  "title": "Word Hunt",
  "statement": "A word game shows a board of letters. A word is found if it can be traced through letters that share a side, using each board cell at most once per word. Given a list of distinct words, return the words that can be found, in alphabetical order.",
  "examples": [
    {
      "input": "board = [[\"o\", \"a\", \"a\", \"n\"], [\"e\", \"t\", \"a\", \"e\"], [\"i\", \"h\", \"k\", \"r\"], [\"i\", \"f\", \"l\", \"v\"]], words = [\"oath\", \"pea\", \"eat\", \"rain\"]",
      "output": "[\"eat\", \"oath\"]"
    },
    {
      "input": "board = [[\"a\", \"b\"], [\"c\", \"d\"]], words = [\"abcb\"]",
      "output": "[]"
    }
  ],
  "constraints": [
    "1 <= rows, columns <= 12",
    "1 <= words.length <= 3 * 10^4",
    "1 <= words[i].length <= 10",
    "lowercase letters only"
  ],
  "answerKey": {
    "pattern": "Put all words in a trie, then one DFS from every cell that follows trie edges",
    "keyPoints": [
      "Build a trie of the words, storing the word at its end node",
      "From each cell, DFS to neighbours only while the next letter is a child in the trie",
      "Record words when an end node is reached; mark cells as used during the path and restore them afterwards"
    ],
    "timeComplexity": "O(cells · 4 · 3^(L − 1)) worst case, far less with trie pruning",
    "spaceComplexity": "O(total letters + L)",
    "edgeCases": [
      "A word longer than the board",
      "The same cell cannot be reused",
      "Many words sharing prefixes"
    ],
    "acceptableSlowerApproaches": [
      "Run a separate board search for each word: O(words · cells · 3^L)"
    ]
  },
  "hints": [
    "Why is searching the board once per word slow when there are many words?",
    "Words with the same start share work. A trie lets one search follow all of them at once.",
    "DFS from each cell guided by trie children; when a node holds a word, add it (once)."
  ],
  "starterCode": {
    "javascript": "function wordHunt(board, words) {\n  // return the found words in alphabetical order\n}",
    "java": "class Solution {\n  List<String> wordHunt(char[][] board, String[] words) {\n    // return the found words in alphabetical order\n  }\n}"
  },
