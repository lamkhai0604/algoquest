{
  "id": "L26-longest-buildable",
  "level": 26,
  "difficulty": "Easy",
  "use": "test",
  "status": "ready",
  "title": "Longest Buildable Word",
  "statement": "A child builds words one letter at a time, adding a letter to the end, and every step must itself be a word in the dictionary. Return the longest dictionary word that can be built this way; if several have the same length, return the one that comes first alphabetically. Return an empty string if none can be built.",
  "examples": [
    {
      "input": "words = [\"w\", \"wo\", \"wor\", \"worl\", \"world\"]",
      "output": "\"world\""
    },
    {
      "input": "words = [\"a\", \"banana\", \"app\", \"appl\", \"ap\", \"apply\", \"apple\"]",
      "output": "\"apple\""
    }
  ],
  "constraints": [
    "1 <= words.length <= 1000",
    "1 <= words[i].length <= 30",
    "lowercase letters only"
  ],
  "answerKey": {
    "pattern": "A trie of all words, then DFS only through nodes that end a word",
    "keyPoints": [
      "Insert every word with an end mark",
      "From the root, go only to children that end a word",
      "The deepest such node wins; visit children in alphabetical order so ties keep the first word"
    ],
    "timeComplexity": "O(total letters)",
    "spaceComplexity": "O(total letters)",
    "edgeCases": [
      "No one-letter word: empty string",
      "Ties in length",
      "Words that are not buildable but long"
    ],
    "acceptableSlowerApproaches": [
      "Sort words, keep a set of buildable ones: O(n log n · L), also fine"
    ]
  },
  "hints": [
    "What must be true about every prefix of a buildable word?",
    "Each prefix is itself a word, so every node on its trie path has an end mark.",
    "DFS from the root through end-marked children only; track the deepest, alphabetical first."
  ],
  "starterCode": {
    "javascript": "function longestBuildable(words) {\n  // return the longest buildable word\n}",
    "java": "class Solution {\n  String longestBuildable(String[] words) {\n    // return the longest buildable word\n  }\n}"
  },
