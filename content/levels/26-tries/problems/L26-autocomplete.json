{
  "id": "L26-autocomplete",
  "level": 26,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 1,
  "title": "Autocomplete",
  "statement": "A shop's search box suggests products as a customer types. After each letter of the query, suggest up to three product names that start with the letters typed so far, in alphabetical order (smallest first). Return the list of suggestions after each letter.",
  "examples": [
    {
      "input": "products = [\"mobile\", \"mouse\", \"moneypot\", \"monitor\", \"mousepad\"], query = \"mouse\"",
      "output": "[[\"mobile\", \"moneypot\", \"monitor\"], [\"mobile\", \"moneypot\", \"monitor\"], [\"mouse\", \"mousepad\"], [\"mouse\", \"mousepad\"], [\"mouse\", \"mousepad\"]]"
    },
    {
      "input": "products = [\"havana\"], query = \"tatiana\"",
      "output": "[[], [], [], [], [], [], []]"
    }
  ],
  "constraints": [
    "1 <= products.length <= 1000",
    "1 <= products[i].length, query.length <= 30",
    "lowercase letters only"
  ],
  "answerKey": {
    "pattern": "A trie whose nodes keep the three smallest words below them (or sort and binary search)",
    "keyPoints": [
      "Sort the products first",
      "Insert each product; on every node along its path, add it to that node's list if the list has fewer than 3 words",
      "For each prefix of the query, read the list at that node (empty once the path breaks)"
    ],
    "timeComplexity": "O(total letters · log) for sorting + O(total letters) for building",
    "spaceComplexity": "O(total letters)",
    "edgeCases": [
      "Query with no match",
      "Fewer than three matches",
      "Products that are prefixes of each other"
    ],
    "acceptableSlowerApproaches": [
      "Filter all products for each prefix: O(query length · n · L)",
      "Sort, then binary search the first match for each prefix: O(n log n + query length · log n)"
    ]
  },
  "hints": [
    "If the products are sorted first, which three to keep at each trie node is easy. Why?",
    "Inserted in sorted order, the first three words to reach a node are its three smallest.",
    "Keep a list of at most 3 words per node; after the path breaks, all answers are empty."
  ],
  "starterCode": {
    "javascript": "function autocomplete(products, query) {\n  // return the suggestions after each letter\n}",
    "java": "class Solution {\n  List<List<String>> autocomplete(String[] products, String query) {\n    // return the suggestions after each letter\n  }\n}"
  },
  "similarLeetCode": "Search Suggestions System",
