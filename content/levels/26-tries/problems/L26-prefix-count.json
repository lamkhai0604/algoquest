{
  "id": "L26-prefix-count",
  "level": 26,
  "difficulty": "Easy",
  "use": "practice",
  "status": "ready",
  "order": 1,
  "title": "Prefix Count",
  "statement": "A search box keeps a list of saved searches (repeats allowed). For each query prefix, return how many saved searches start with it.",
  "examples": [
    {
      "input": "searches = [\"apple\", \"app\", \"apply\", \"bat\"], prefixes = [\"app\", \"ba\", \"c\"]",
      "output": "[3, 1, 0]"
    },
    {
      "input": "searches = [\"a\", \"a\"], prefixes = [\"a\"]",
      "output": "[2]"
    }
  ],
  "constraints": [
    "1 <= searches.length, prefixes.length <= 10^4",
    "1 <= length of each string <= 20",
    "lowercase letters only"
  ],
  "answerKey": {
    "pattern": "A trie where each node stores how many words pass through it",
    "keyPoints": [
      "Insert every search, adding 1 to the count of each node on its path",
      "For a prefix, walk down the trie; the count at the last node is the answer",
      "A missing letter means 0"
    ],
    "timeComplexity": "O(total letters of searches + total letters of prefixes)",
    "spaceComplexity": "O(total letters of searches)",
    "edgeCases": [
      "Prefix longer than every word: 0",
      "Repeated searches count twice",
      "A prefix equal to a whole word"
    ],
    "acceptableSlowerApproaches": [
      "Check every search against every prefix: O(n · q · L)",
      "Sort and binary search the prefix range: O((n + q) log n · L)"
    ]
  },
  "hints": [
    "What do all words with the same prefix share in a trie?",
    "The path for that prefix: they all pass through its last node.",
    "Store a pass-through count in each node while inserting."
  ],
  "starterCode": {
    "javascript": "function prefixCount(searches, prefixes) {\n  // return the count for each prefix\n}",
    "java": "class Solution {\n  int[] prefixCount(String[] searches, String[] prefixes) {\n    // return the count for each prefix\n  }\n}"
  },
  "similarLeetCode": "Implement Trie (Prefix Tree)",
