{
  "id": "L20-fewest-flashes",
  "level": 20,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 3,
  "title": "Fewest Flashes",
  "statement": "Each guest at a party is in the photo area during [start, end] (both ends included). A camera flash at time t photographs every guest present at t. Return the fewest flashes so that every guest is photographed at least once.",
  "examples": [
    {
      "input": "guests = [[10, 16], [2, 8], [1, 6], [7, 12]]",
      "output": "2"
    },
    {
      "input": "guests = [[1, 2], [3, 4], [5, 6]]",
      "output": "3"
    }
  ],
  "constraints": [
    "1 <= guests.length <= 10^4",
    "-10^6 <= start <= end <= 10^6"
  ],
  "answerKey": {
    "pattern": "Greedy: sort by end and flash at the end of the first unphotographed guest",
    "keyPoints": [
      "Sort by end",
      "Flash at the end of the earliest-ending guest not yet photographed",
      "Skip every guest whose start is at or before that flash"
    ],
    "timeComplexity": "O(n log n)",
    "spaceComplexity": "O(1) extra besides sorting",
    "edgeCases": [
      "One guest",
      "Guests touching at one moment share a flash",
      "Negative times"
    ],
    "acceptableSlowerApproaches": [
      "Try flashes at every endpoint combination: exponential"
    ]
  },
  "hints": [
    "The guest who leaves first must be photographed before they leave.",
    "Flashing as late as possible for that guest, at their end, catches the most others.",
    "Sort by end; flash = -infinity; for each guest, if start > flash, count++ and flash = end."
  ],
  "starterCode": {
    "javascript": "function fewestFlashes(guests) {\n  // return the fewest flashes\n}",
    "java": "class Solution {\n  int fewestFlashes(int[][] guests) {\n    // return the fewest flashes\n  }\n}"
  },
