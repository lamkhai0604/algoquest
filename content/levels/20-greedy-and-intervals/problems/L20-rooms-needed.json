{
  "id": "L20-rooms-needed",
  "level": 20,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 1,
  "title": "Rooms Needed",
  "statement": "Meetings are given as [start, end]. A room is free again at the moment its meeting ends, so a meeting starting at that moment can use it. Return the fewest rooms that can host every meeting.",
  "examples": [
    {
      "input": "meetings = [[0, 30], [5, 10], [15, 20]]",
      "output": "2"
    },
    {
      "input": "meetings = [[7, 10], [2, 4], [4, 7]]",
      "output": "1"
    }
  ],
  "constraints": [
    "1 <= meetings.length <= 10^4",
    "0 <= start < end <= 10^6"
  ],
  "answerKey": {
    "pattern": "Sweep over sorted starts and sorted ends",
    "keyPoints": [
      "Sort the starts and the ends separately",
      "Walk the starts; before each start, free every room whose end is at most that start",
      "The answer is the most rooms in use at once"
    ],
    "timeComplexity": "O(n log n)",
    "spaceComplexity": "O(n)",
    "edgeCases": [
      "One meeting",
      "All meetings at once: n rooms",
      "Back-to-back meetings share a room"
    ],
    "acceptableSlowerApproaches": [
      "Min-heap of end times: O(n log n), also fine",
      "Count meetings at every time unit: O(range · n)"
    ]
  },
  "hints": [
    "What matters is how many meetings are running at the same moment.",
    "Sort the start times and the end times on their own lists.",
    "For each start (in order), while the earliest unused end <= start, free a room; then take one. Track the maximum."
  ],
  "starterCode": {
    "javascript": "function roomsNeeded(meetings) {\n  // return the fewest rooms\n}",
    "java": "class Solution {\n  int roomsNeeded(int[][] meetings) {\n    // return the fewest rooms\n  }\n}"
  },
