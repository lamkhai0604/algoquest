  "use": "practice",
  "status": "ready",
  "order": 2,
  "title": "Stepping Stones",
  "statement": "Stones lie in a row. From stone i you can jump forward to any stone up to reach[i] places ahead. You start on stone 0 and it is always possible to reach the last stone. Return the fewest jumps to get there.",
  "examples": [
    {
      "input": "reach = [2, 3, 1, 1, 4]",
      "output": "2"
    },
    {
      "input": "reach = [1, 1, 1]",
      "output": "2"
    }
  ],
  "constraints": [
    "1 <= reach.length <= 10^4",
    "1 <= reach[i] <= 1000 (every stone can jump at least 1)"
  ],
  "answerKey": {
    "pattern": "Greedy by levels: the stones reachable with k jumps form a range",
    "keyPoints": [
      "Keep the end of the range reachable with the current number of jumps",
      "While walking that range, track the farthest stone reachable with one more jump",
      "When you pass the end of the range, take a jump and move the end to the farthest"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "One stone: 0 jumps",
      "Every reach is 1: n − 1 jumps",
      "First jump reaches the end"
    ],
    "acceptableSlowerApproaches": [
      "BFS over stones: O(n · max reach)",
      "DP: O(n · max reach)"
    ]
  },
  "hints": [
    "Think of BFS levels: which stones can be reached with exactly one jump? With two?",
    "Those stones always form a contiguous range, so you only need its end.",
    "Walk i from 0 to n − 2: farthest = max(farthest, i + reach[i]); if i equals the current end, jumps++ and end = farthest."
  ],
  "starterCode": {
    "javascript": "function steppingStones(reach) {\n  // return the fewest jumps\n}",
    "java": "class Solution {\n  int steppingStones(int[] reach) {\n    // return the fewest jumps\n  }\n}"
  },
