{
  "id": "L20-most-talks",
  "level": 20,
  "difficulty": "Easy",
  "use": "practice",
  "status": "ready",
  "order": 1,
  "title": "Most Talks",
  "statement": "A conference has one stage and a list of talks, each given as [start, end]. A talk can start at the same moment the previous one ends. Return the largest number of talks the stage can host without any two overlapping.",
  "examples": [
    {
      "input": "talks = [[1, 3], [2, 5], [4, 7], [1, 8], [5, 9], [8, 10], [9, 12]]",
      "output": "3"
    },
    {
      "input": "talks = [[1, 2], [2, 3], [3, 4]]",
      "output": "3"
    }
  ],
  "constraints": [
    "1 <= talks.length <= 1000",
    "0 <= start < end <= 10^6"
  ],
  "answerKey": {
    "pattern": "Greedy: sort by end, keep each talk that starts after the last kept end",
    "keyPoints": [
      "Sort the talks by end time",
      "Keep a talk when its start is at least the end of the last kept talk",
      "Ending earliest leaves the most room for the rest (exchange argument)"
    ],
    "timeComplexity": "O(n log n)",
    "spaceComplexity": "O(1) extra besides sorting",
    "edgeCases": [
      "One talk",
      "All talks overlap: 1",
      "Touching talks all fit"
    ],
    "acceptableSlowerApproaches": [
      "Try every subset: O(2^n)",
      "DP over talks sorted by end with binary search: O(n log n), more code"
    ]
  },
  "hints": [
    "Which talk would you keep first, so that the most room is left for the others?",
    "Keeping the talk that ends earliest never hurts: any plan can swap its first talk for that one.",
    "Sort by end; walk once, keeping a talk when start >= lastEnd, and update lastEnd."
  ],
  "starterCode": {
    "javascript": "function mostTalks(talks) {\n  // return the most talks without overlap\n}",
    "java": "class Solution {\n  int mostTalks(int[][] talks) {\n    // return the most talks without overlap\n  }\n}"
  },
