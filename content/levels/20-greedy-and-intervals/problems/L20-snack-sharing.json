  "level": 20,
  "difficulty": "Easy",
  "use": "practice",
  "status": "ready",
  "order": 3,
  "title": "Snack Sharing",
  "statement": "Each child has a hunger level and each snack has a size. A child is happy with one snack whose size is at least their hunger level; each snack goes to at most one child. Return the largest number of happy children.",
  "examples": [
    {
      "input": "hunger = [1, 2, 3], sizes = [1, 1]",
      "output": "1"
    },
    {
      "input": "hunger = [1, 2], sizes = [1, 2, 3]",
      "output": "2"
    }
  ],
  "constraints": [
    "1 <= hunger.length, sizes.length <= 3 * 10^4",
    "1 <= hunger[i], sizes[j] <= 10^6"
  ],
  "answerKey": {
    "pattern": "Greedy with two sorted lists",
    "keyPoints": [
      "Sort both lists",
      "Give the smallest snack that is big enough to the least hungry child",
      "Move to the next snack whenever a snack is too small"
    ],
    "timeComplexity": "O(n log n + m log m)",
    "spaceComplexity": "O(1) extra besides sorting",
    "edgeCases": [
      "No snack big enough: 0",
      "More snacks than children",
      "Equal sizes and hunger"
    ],
    "acceptableSlowerApproaches": [
      "For each child scan all snacks: O(n · m)"
    ]
  },
  "hints": [
    "Which child is easiest to satisfy?",
    "Feeding the least hungry child with the smallest snack that works never blocks a better plan.",
    "Sort both; with pointers i (child) and j (snack): if sizes[j] >= hunger[i], i++; always j++."
  ],
  "starterCode": {
    "javascript": "function snackSharing(hunger, sizes) {\n  // return the most happy children\n}",
    "java": "class Solution {\n  int snackSharing(int[] hunger, int[] sizes) {\n    // return the most happy children\n  }\n}"
  },
