  "status": "ready",
  "title": "Exact Change",
  "statement": "A juice stand sells cups for 5 each. Customers pay one at a time with a 5, 10 or 20 bill, and the stand starts with no money. Return true if the stand can give every customer the right change in order, otherwise false.",
  "examples": [
    {
      "input": "bills = [5, 5, 5, 10, 20]",
      "output": "true"
    },
    {
      "input": "bills = [5, 5, 10, 10, 20]",
      "output": "false"
    }
  ],
  "constraints": [
    "1 <= bills.length <= 10^5",
    "bills[i] is 5, 10 or 20"
  ],
  "answerKey": {
    "pattern": "Greedy: give change with the largest bills first",
    "keyPoints": [
      "Count the 5 and 10 bills held",
      "A 10 needs one 5 back",
      "For a 20, give 10 + 5 if possible, else three 5s; fives are more useful later"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "First customer pays 10: false",
      "Only 5s: true",
      "Many 20s"
    ],
    "acceptableSlowerApproaches": [
      "Try every way to give change: exponential"
    ]
  },
  "hints": [
    "Which bills do you need to keep track of?",
    "20s are never used as change.",
    "For a 20, prefer giving a 10 and a 5: fives can pay change for both 10s and 20s."
  ],
  "starterCode": {
    "javascript": "function exactChange(bills) {\n  // return whether change is always possible\n}",
    "java": "class Solution {\n  boolean exactChange(int[] bills) {\n    // return whether change is always possible\n  }\n}"
  },
