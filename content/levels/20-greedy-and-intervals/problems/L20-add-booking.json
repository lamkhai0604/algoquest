{
  "id": "L20-add-booking",
  "level": 20,
  "difficulty": "Easy",
  "use": "test",
  "status": "ready",
  "title": "Add a Booking",
  "statement": "A calendar holds busy blocks [start, end] sorted by start, with no two overlapping or touching. Add one new booking and return the blocks, still sorted and merged (blocks that overlap or touch the new booking become one).",
  "examples": [
    {
      "input": "blocks = [[1, 3], [6, 9]], booking = [2, 5]",
      "output": "[[1, 5], [6, 9]]"
    },
    {
      "input": "blocks = [[1, 2], [4, 5], [7, 9]], booking = [5, 7]",
      "output": "[[1, 2], [4, 9]]"
    }
  ],
  "constraints": [
    "0 <= blocks.length <= 10^4",
    "0 <= start <= end <= 10^6"
  ],
  "answerKey": {
    "pattern": "One pass: copy blocks before, merge the overlapping ones, copy the rest",
    "keyPoints": [
      "Copy blocks that end before the booking starts",
      "Merge every block that starts at or before the booking's end by widening the booking",
      "Copy the remaining blocks"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(n) for the output",
    "edgeCases": [
      "Empty calendar",
      "Booking before all or after all",
      "Booking covering every block"
    ],
    "acceptableSlowerApproaches": [
      "Append and run a full sort-and-merge: O(n log n)"
    ]
  },
  "hints": [
    "The blocks are already sorted, so three groups appear in order.",
    "Blocks entirely before, blocks that touch or overlap the booking, blocks entirely after.",
    "While block end < booking start copy; while block start <= booking end widen the booking; push it; copy the rest."
  ],
  "starterCode": {
    "javascript": "function addBooking(blocks, booking) {\n  // return the merged calendar\n}",
    "java": "class Solution {\n  int[][] addBooking(int[][] blocks, int[] booking) {\n    // return the merged calendar\n  }\n}"
  },
