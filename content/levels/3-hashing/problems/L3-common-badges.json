{
  "id": "L3-common-badges",
  "level": 3,
  "difficulty": "Easy",
  "use": "test",
  "status": "ready",
  "title": "Common Badges",
  "statement": "Two doors log badge IDs. Return the IDs that appear in both logs, each once, in ascending order.",
  "examples": [
    {
      "input": "[4, 1, 7, 4], [7, 4, 9]",
      "output": "[4, 7]"
    },
    {
      "input": "[1, 2], [3]",
      "output": "[]"
    }
  ],
  "constraints": [
    "0 <= a.length, b.length <= 10^5"
  ],
  "answerKey": {
    "pattern": "Hash set of one log, then look up the other",
    "keyPoints": [
      "Put the IDs of the first log in a set",
      "For each ID of the second log that is in the set, add it to the result set",
      "Return the result sorted"
    ],
    "timeComplexity": "O(n + m + r log r), r = number of common IDs",
    "spaceComplexity": "O(n)",
    "edgeCases": [
      "No common IDs returns []",
      "Duplicates appear once",
      "An empty log"
    ],
    "acceptableSlowerApproaches": [
      "Compare every pair: O(n * m)"
    ]
  },
  "hints": [
    "Comparing every pair is slow. Which structure makes \"is this ID in the other log?\" fast?",
    "Put one log in a set and walk through the other.",
    "Use a second set for the answer so duplicates appear once, then sort it."
  ],
  "tests": [
