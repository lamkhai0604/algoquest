      "output": "12"
    },
    {
      "input": "fruit = [[5]]",
      "output": "5"
    }
  ],
  "constraints": [
    "1 <= rows, columns <= 100",
    "0 <= fruit[r][c] <= 100"
  ],
  "answerKey": {
    "pattern": "2-D DP: best(r, c) = fruit[r][c] + max(best from above, best from the left)",
    "keyPoints": [
      "Edges have only one way in",
      "Each tree takes the better of above and left",
      "One row of values is enough"
    ],
    "timeComplexity": "O(rows · columns)",
    "spaceComplexity": "O(columns)",
    "edgeCases": [
      "One tree",
      "One row",
      "All zeros"
    ],
    "acceptableSlowerApproaches": [
      "Try every path: exponential"
    ]
  },
  "hints": [
    "Where can the picker come from to reach a tree?",
    "From above or from the left.",
    "best[c] = fruit[r][c] + max(best[c], best[c − 1]) on each row."
