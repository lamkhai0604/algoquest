{
  "id": "L23-stacked-cups",
  "level": 23,
  "difficulty": "Easy",
  "use": "practice",
  "status": "ready",
  "order": 3,
  "title": "Stacked Cups",
  "statement": "Cups are stacked in a triangle: row i has i + 1 cups, each with a number of points (possibly negative). A ball starts at the top cup and drops one row at a time, landing either directly below or below and one to the right. Return the smallest total of points on its way to the bottom row.",
  "examples": [
    {
      "input": "rows = [[2], [3, 4], [6, 5, 7], [4, 1, 8, 3]]",
      "output": "11"
    },
    {
      "input": "rows = [[-10]]",
      "output": "-10"
    }
  ],
  "constraints": [
    "1 <= rows.length <= 200",
    "rows[i].length = i + 1",
    "-10^4 <= points <= 10^4"
  ],
  "answerKey": {
    "pattern": "DP from the bottom up: best(r, c) = rows[r][c] + min(best(r + 1, c), best(r + 1, c + 1))",
    "keyPoints": [
      "Start from the bottom row, where the answer is the cup itself",
      "Each cup takes the better of the two cups below it",
      "The top cell holds the answer; one row of values is enough"
    ],
    "timeComplexity": "O(n²)",
    "spaceComplexity": "O(n)",
    "edgeCases": [
      "One row",
      "Negative points",
      "All equal"
    ],
    "acceptableSlowerApproaches": [
      "Try every path: O(2^n)"
    ]
  },
  "hints": [
    "Working from the top, the ball has many futures; from the bottom, each cup has just two children.",
    "Fill from the bottom row upward.",
    "best[c] = rows[r][c] + min(best[c], best[c + 1]), going up row by row."
  ],
  "starterCode": {
    "javascript": "function stackedCups(rows) {\n  // return the smallest total\n}",
    "java": "class Solution {\n  int stackedCups(int[][] rows) {\n    // return the smallest total\n  }\n}"
  },
