  "status": "ready",
  "order": 2,
  "title": "Backpack Value",
  "statement": "A hiker can carry at most capacity kilograms. Item i weighs weight[i] and is worth value[i]; each item is taken whole or left behind. Return the largest total value that fits.",
  "examples": [
    {
      "input": "weight = [1, 3, 4, 5], value = [1, 4, 5, 7], capacity = 7",
      "output": "9"
    },
    {
      "input": "weight = [5], value = [10], capacity = 4",
      "output": "0"
    }
  ],
  "constraints": [
    "1 <= n <= 100",
    "1 <= weight[i] <= 1000",
    "0 <= value[i] <= 1000",
    "0 <= capacity <= 10^4"
  ],
  "answerKey": {
    "pattern": "0/1 knapsack DP: best(c) over capacities, items processed one by one, capacities from high to low",
    "keyPoints": [
      "State: the best value with capacity c using the items seen so far",
      "For each item, best(c) = max(best(c), best(c − weight) + value)",
      "Go from high c to low so each item is used at most once"
    ],
    "timeComplexity": "O(n · capacity)",
    "spaceComplexity": "O(capacity)",
    "edgeCases": [
      "Nothing fits: 0",
      "Capacity 0",
      "An item of value 0"
    ],
    "acceptableSlowerApproaches": [
      "Try every subset: O(2^n)",
      "Full 2-D table: same time, O(n · capacity) space"
    ]
  },
  "hints": [
    "For each item there are two choices: take it or leave it.",
    "best[c] after this item = max(leave: best[c], take: best[c − w] + v).",
    "Loop c from capacity down to w, so best[c − w] still describes the earlier items."
  ],
  "starterCode": {
    "javascript": "function backpackValue(weight, value, capacity) {\n  // return the largest value\n}",
    "java": "class Solution {\n  int backpackValue(int[] weight, int[] value, int capacity) {\n    // return the largest value\n  }\n}"
  },
