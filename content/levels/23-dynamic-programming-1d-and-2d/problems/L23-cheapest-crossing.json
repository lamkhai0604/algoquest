  "level": 23,
  "difficulty": "Easy",
  "use": "practice",
  "status": "ready",
  "order": 2,
  "title": "Cheapest Crossing",
  "statement": "A rover crosses a field of tiles from the top-left tile to the bottom-right tile, moving only right or down. Each tile has an energy cost, paid on entering it (including the first and last tiles). Return the smallest total cost.",
  "examples": [
    {
      "input": "cost = [[1, 3, 1], [1, 5, 1], [4, 2, 1]]",
      "output": "7"
    },
    {
      "input": "cost = [[1, 2, 3], [4, 5, 6]]",
      "output": "12"
    }
  ],
  "constraints": [
    "1 <= rows, columns <= 100",
    "0 <= cost[r][c] <= 100"
  ],
  "answerKey": {
    "pattern": "2-D DP: best(r, c) = cost[r][c] + min(best(r − 1, c), best(r, c − 1))",
    "keyPoints": [
      "The first row and first column have one way in",
      "Every other tile is entered from above or from the left",
      "One row of values is enough"
    ],
    "timeComplexity": "O(rows · columns)",
    "spaceComplexity": "O(columns)",
    "edgeCases": [
      "One tile",
      "One row or one column",
      "All zeros"
    ],
    "acceptableSlowerApproaches": [
      "Try every path: exponential",
      "Dijkstra: works but slower and more code"
    ]
  },
  "hints": [
    "How can the rover arrive at tile (r, c)?",
    "From above or from the left; take the cheaper one.",
    "best[r][c] = cost[r][c] + min(above, left), with only one neighbour on the edges."
  ],
  "starterCode": {
    "javascript": "function cheapestCrossing(cost) {\n  // return the smallest total cost\n}",
    "java": "class Solution {\n  int cheapestCrossing(int[][] cost) {\n    // return the smallest total cost\n  }\n}"
