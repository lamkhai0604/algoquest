  "status": "ready",
  "order": 3,
  "title": "Gift Card Split",
  "statement": "Two friends want to split a pile of gift cards so that both get exactly the same total amount. Each card goes to one friend. Return true if a fair split exists.",
  "examples": [
    {
      "input": "cards = [1, 5, 11, 5]",
      "output": "true"
    },
    {
      "input": "cards = [1, 2, 3, 5]",
      "output": "false"
    }
  ],
  "constraints": [
    "1 <= cards.length <= 200",
    "1 <= cards[i] <= 100"
  ],
  "answerKey": {
    "pattern": "Subset-sum DP: can(s) for sums up to total / 2, cards processed one by one, sums from high to low",
    "keyPoints": [
      "An odd total can never split",
      "Look for a subset that adds up to total / 2",
      "can(0) = true; for each card, can(s) |= can(s − card), going down"
    ],
    "timeComplexity": "O(n · total)",
    "spaceComplexity": "O(total)",
    "edgeCases": [
      "One card: false",
      "Odd total",
      "All cards equal"
    ],
    "acceptableSlowerApproaches": [
      "Try every subset: O(2^n)"
    ]
  },
  "hints": [
    "What must each friend's total be?",
    "Half the total: the question becomes whether some cards add up to exactly that.",
    "Boolean knapsack: can[s] = can[s] || can[s − card], s from target down to card."
  ],
  "starterCode": {
    "javascript": "function giftCardSplit(cards) {\n  // return whether a fair split exists\n}",
    "java": "class Solution {\n  boolean giftCardSplit(int[] cards) {\n    // return whether a fair split exists\n  }\n}"
  },
