{
  "id": "L17-smallest-code",
  "level": 17,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 3,
  "title": "Smallest Code",
  "statement": "A code is a string of digits. Delete exactly k digits, keeping the order of the rest, so the remaining number is as small as possible. Return it without leading zeros; return \"0\" if nothing is left.",
  "examples": [
    {
      "input": "code = \"1432219\", k = 3",
      "output": "\"1219\""
    },
    {
      "input": "code = \"10200\", k = 1",
      "output": "\"200\""
    }
  ],
  "constraints": [
    "1 <= k <= code.length <= 100000",
    "code has digits only and no leading zeros"
  ],
  "answerKey": {
    "pattern": "Greedy monotonic stack",
    "keyPoints": [
      "Scan digits; while k > 0 and the top digit is bigger than the new digit, pop it and lower k",
      "Push the new digit",
      "If k is still > 0, remove digits from the end",
      "Strip leading zeros; empty means \"0\""
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(n)",
    "edgeCases": [
      "k equals the length",
      "Leading zeros after deletions",
      "Already increasing digits: delete from the end"
    ],
    "acceptableSlowerApproaches": [
      "Repeat k times: remove the first digit bigger than the next: O(n · k)"
    ]
  },
  "hints": [
    "Which digit hurts the number most: a big digit early, or a big digit late?",
    "Early. A digit followed by a smaller digit should be deleted first.",
    "Keep a stack of digits; pop while the top is bigger than the new digit and k > 0. Trim from the end if k is left, then strip leading zeros."
  ],
  "starterCode": {
    "javascript": "function smallestCode(code, k) {\n  // return the smallest code after k deletions\n}",
    "java": "class Solution {\n  String smallestCode(String code, int k) {\n    // return the smallest code after k deletions\n  }\n}"
  },
  "similarLeetCode": "Remove K Digits",
