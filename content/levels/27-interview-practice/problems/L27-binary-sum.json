  "id": "L27-binary-sum",
  "level": 27,
  "difficulty": "Easy",
  "use": "practice",
  "status": "ready",
  "order": 1,
  "title": "Binary Sum",
  "statement": "Two counters are stored as binary strings with no leading zeros (except \"0\" itself). Return their sum as a binary string. The strings can be far longer than any built-in integer type.",
  "examples": [
    {
      "input": "a = \"11\", b = \"1\"",
      "output": "\"100\""
    },
    {
      "input": "a = \"1010\", b = \"1011\"",
      "output": "\"10101\""
    }
  ],
  "constraints": [
    "1 <= a.length, b.length <= 10^4",
    "a and b contain only 0 and 1"
  ],
  "answerKey": {
    "pattern": "Add from the right with a carry, like adding by hand",
    "keyPoints": [
      "Walk both strings from the last digit",
      "digit = (x + y + carry) % 2, carry = (x + y + carry) / 2",
      "Add a final 1 if a carry is left; reverse the collected digits"
    ],
    "timeComplexity": "O(max(n, m))",
    "spaceComplexity": "O(max(n, m)) for the output",
    "edgeCases": [
      "\"0\" + \"0\"",
      "Different lengths",
      "A carry that runs all the way"
    ],
    "acceptableSlowerApproaches": [
      "Convert to a number: overflows for long strings"
    ]
  },
  "hints": [
    "What would you do on paper?",
    "Start from the rightmost digits and carry 1 when the column sum is 2 or 3.",
    "Two pointers from the ends and a carry; build the result backwards."
  ],
  "starterCode": {
    "javascript": "function binarySum(a, b) {\n  // return the sum as a binary string\n}",
    "java": "class Solution {\n  String binarySum(String a, String b) {\n    // return the sum as a binary string\n  }\n}"
  },
