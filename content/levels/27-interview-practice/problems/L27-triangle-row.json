  "status": "ready",
  "order": 3,
  "title": "Triangle Row",
  "statement": "In Pascal's triangle each number is the sum of the two above it, and every row starts and ends with 1. Rows are numbered from 0. Return row k.",
  "examples": [
    {
      "input": "k = 3",
      "output": "[1, 3, 3, 1]"
    },
    {
      "input": "k = 0",
      "output": "[1]"
    }
  ],
  "constraints": [
    "0 <= k <= 33 (all values fit in a 32-bit integer)"
  ],
  "answerKey": {
    "pattern": "Build the row in place from right to left",
    "keyPoints": [
      "Start with [1]",
      "For each next row, append 1 and update positions from right to left: row[j] += row[j − 1]",
      "Going right to left keeps the old values needed"
    ],
    "timeComplexity": "O(k²)",
    "spaceComplexity": "O(k)",
    "edgeCases": [
      "k = 0",
      "k = 1",
      "Largest k: values near 1.2 billion"
    ],
    "acceptableSlowerApproaches": [
      "Build the whole triangle: O(k²) space",
      "Binomial formula: needs care with overflow"
    ]
  },
  "hints": [
    "How is each value of the next row made from the current one?",
    "row[j] (new) = row[j] + row[j − 1] (old).",
    "Update from the right end so that row[j − 1] is still the old value."
  ],
  "starterCode": {
    "javascript": "function triangleRow(k) {\n  // return row k\n}",
    "java": "class Solution {\n  int[] triangleRow(int k) {\n    // return row k\n  }\n}"
  },
