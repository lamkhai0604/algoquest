  "level": 27,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 2,
  "title": "Next Arrangement",
  "statement": "A lock shows a row of digits. Return the arrangement of the same digits that comes next in dictionary order (the smallest arrangement greater than the current one). If the current arrangement is the largest, return the smallest one (sorted ascending).",
  "examples": [
    {
      "input": "digits = [1, 2, 3]",
      "output": "[1, 3, 2]"
    },
    {
      "input": "digits = [3, 2, 1]",
      "output": "[1, 2, 3]"
    }
  ],
  "constraints": [
    "1 <= digits.length <= 100",
    "0 <= digits[i] <= 100"
  ],
  "answerKey": {
    "pattern": "Find the rightmost rise, swap with the next larger value to its right, reverse the tail",
    "keyPoints": [
      "From the right, find the first i with a[i] < a[i + 1]",
      "If none, reverse the whole row",
      "Otherwise swap a[i] with the rightmost value larger than it, then reverse everything after i"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1) in place",
    "edgeCases": [
      "Already the largest: wrap to the smallest",
      "Repeated digits",
      "One digit"
    ],
    "acceptableSlowerApproaches": [
      "Generate all arrangements and sort: O(n! · n)"
    ]
  },
  "hints": [
    "Which part of the row has to change for the very next arrangement?",
    "The shortest tail that is not already in descending order.",
    "Find the pivot, swap it with the smallest larger value in the tail, then reverse the tail."
  ],
  "starterCode": {
    "javascript": "function nextArrangement(digits) {\n  // return the next arrangement\n}",
    "java": "class Solution {\n  int[] nextArrangement(int[] digits) {\n    // return the next arrangement\n  }\n}"
  },
