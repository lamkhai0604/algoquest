  "difficulty": "Medium",
  "use": "test",
  "status": "ready",
  "title": "Biggest Park",
  "statement": "A city plan is a grid where 1 is green space and 0 is built land. Green cells that touch up, down, left or right form one park. Return the number of cells in the largest park, or 0 if there is no green space.",
  "examples": [
    {
      "input": "plan = [[1, 1, 0], [0, 1, 0], [1, 0, 1]]",
      "output": "3"
    },
    {
      "input": "plan = [[0, 0, 0]]",
      "output": "0"
    }
  ],
  "constraints": [
    "1 <= rows, cols <= 30",
    "plan[r][c] is 0 or 1"
  ],
  "answerKey": {
    "pattern": "Connected components on a grid, measuring each one's size",
    "keyPoints": [
      "Scan every cell",
      "At each unvisited green cell, search the whole park and count its cells",
      "Mark cells as visited so each is counted once",
      "Keep the largest count"
    ],
    "timeComplexity": "O(R · C)",
    "spaceComplexity": "O(R · C)",
    "edgeCases": [
      "No green cells: 0",
      "The whole grid is one park",
      "Diagonal cells are separate parks"
    ],
    "acceptableSlowerApproaches": [
      "Start a fresh search from every green cell without shared marks: O((R · C)²)"
    ]
  },
  "hints": [
    "Each park is a connected component of green cells. You need the size of each component.",
    "Search from an unvisited green cell, counting every cell the search marks.",
    "Do this for each new park while scanning the grid, and keep the maximum."
  ],
  "starterCode": {
    "javascript": "function biggestPark(plan) {\n  // return the size of the largest park\n}",
    "java": "class Solution {\n  int biggestPark(int[][] plan) {\n    // return the size of the largest park\n  }\n}"
  },
