  "level": 10,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 3,
  "title": "Rumour Spread",
  "statement": "A town is a grid of houses. 0 is an empty lot, 1 is a house that has not heard the rumour, and 2 is a house that has. Every minute, each house that has heard it tells the houses directly up, down, left and right of it. Return the minutes until every house has heard the rumour, or −1 if some house never will. If no house is waiting to hear it, return 0.",
  "examples": [
    {
      "input": "town = [[2, 1, 1], [1, 1, 0], [0, 1, 1]]",
      "output": "4"
    },
    {
      "input": "town = [[2, 1, 1], [0, 1, 1], [1, 0, 1]]",
      "output": "-1"
    }
  ],
  "constraints": [
    "1 <= rows, cols <= 30",
    "town[r][c] is 0, 1 or 2"
  ],
  "answerKey": {
    "pattern": "Multi-source breadth-first search on a grid",
    "keyPoints": [
      "Put every house that already knows (2) into the queue at minute 0",
      "Process the queue one minute (one ring) at a time, informing the four neighbours that are 1",
      "Count the houses still waiting; each newly informed one lowers the count",
      "The answer is the last minute with a new house, or −1 if any house is still waiting"
    ],
    "timeComplexity": "O(R · C)",
    "spaceComplexity": "O(R · C)",
    "edgeCases": [
      "No waiting houses: 0",
      "No informed houses but some waiting: −1",
      "A waiting house cut off by empty lots"
    ],
    "acceptableSlowerApproaches": [
      "Simulate minute by minute, sweeping the whole grid each minute: O((R · C)²)"
    ]
  },
  "hints": [
    "The rumour moves one step per minute from several houses at once. Which search spreads in rings?",
    "Start BFS with all informed houses in the queue together: a multi-source BFS.",
    "Handle the queue level by level and count minutes; at the end, check whether any house is still a 1."
  ],
  "starterCode": {
    "javascript": "function rumourMinutes(town) {\n  // return the minutes, or -1\n}",
    "java": "class Solution {\n  int rumourMinutes(int[][] town) {\n    // return the minutes, or -1\n  }\n}"
  },
