{
  "id": "L10-busiest-station",
  "level": 10,
  "difficulty": "Easy",
  "use": "practice",
  "status": "ready",
  "order": 1,
  "title": "Busiest Station",
  "statement": "A metro map has n stations, numbered 0 to n − 1, and a list of tunnels. Each tunnel joins two different stations and can be used both ways, and no tunnel is listed twice. Return the station with the most tunnels. If several stations tie, return the smallest number.",
  "examples": [
    {
      "input": "n = 4, tunnels = [[0, 1], [1, 2], [1, 3]]",
      "output": "1"
    },
    {
      "input": "n = 3, tunnels = []",
      "output": "0"
    }
  ],
  "constraints": [
    "1 <= n <= 1000",
    "0 <= tunnels.length <= 2000",
    "tunnels[i] = [a, b] with a != b"
  ],
  "answerKey": {
    "pattern": "Degree counting over an edge list",
    "keyPoints": [
      "Keep a count per station, starting at 0",
      "Each tunnel adds 1 to both of its stations",
      "Return the first station with the largest count"
    ],
    "timeComplexity": "O(V + E)",
    "spaceComplexity": "O(V)",
    "edgeCases": [
      "No tunnels: every count is 0, so station 0",
      "Ties go to the smallest number",
      "One station"
    ],
    "acceptableSlowerApproaches": [
      "For each station, scan all tunnels: O(V · E)"
    ]
  },
  "hints": [
    "The number of tunnels at a station is its degree. What does one tunnel add?",
    "One undirected edge adds 1 to the degree of each of its two ends.",
    "Fill an array of counts in one pass over the tunnels, then find the largest, keeping the first on ties."
  ],
  "starterCode": {
    "javascript": "function busiestStation(n, tunnels) {\n  // return the station with the most tunnels\n}",
    "java": "class Solution {\n  int busiestStation(int n, int[][] tunnels) {\n    // return the station with the most tunnels\n  }\n}"
  },
