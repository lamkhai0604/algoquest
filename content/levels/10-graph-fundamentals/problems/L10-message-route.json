{
  "id": "L10-message-route",
  "level": 10,
  "difficulty": "Easy",
  "use": "practice",
  "status": "ready",
  "order": 2,
  "title": "Can the Message Get Through?",
  "statement": "A network has n radio towers, numbered 0 to n − 1. Each link in `links` lets two towers pass messages to each other, both ways. A message starts at tower `from`. Return true if it can reach tower `to` through any chain of links, and false otherwise.",
  "examples": [
    {
      "input": "n = 5, links = [[0, 1], [1, 2], [3, 4]], from = 0, to = 2",
      "output": "true"
    },
    {
      "input": "n = 5, links = [[0, 1], [1, 2], [3, 4]], from = 0, to = 4",
      "output": "false"
    }
  ],
  "constraints": [
    "1 <= n <= 1000",
    "0 <= links.length <= 2000",
    "0 <= from, to < n"
  ],
  "answerKey": {
    "pattern": "Reachability with BFS or DFS and a visited set",
    "keyPoints": [
      "Build an adjacency list, adding each link in both directions",
      "Search from `from`, marking towers as visited so cycles do not loop",
      "Return true as soon as `to` is reached, false when the search ends"
    ],
    "timeComplexity": "O(V + E)",
    "spaceComplexity": "O(V + E)",
    "edgeCases": [
      "from equals to",
      "No links",
      "The links contain a cycle"
    ],
    "acceptableSlowerApproaches": [
      "Repeatedly scan all links, growing the reached set until it stops changing: O(V · E)"
    ]
  },
  "hints": [
    "Towers and links are a graph. The question is whether `to` is in the same connected group as `from`.",
    "Turn the link list into an adjacency list first, so each tower knows its neighbours.",
    "Run BFS or DFS from `from` with a visited array; if `to` gets visited, the answer is true."
  ],
  "starterCode": {
    "javascript": "function canReach(n, links, from, to) {\n  // return true or false\n}",
    "java": "class Solution {\n  boolean canReach(int n, int[][] links, int from, int to) {\n    // return true or false\n  }\n}"
  },
