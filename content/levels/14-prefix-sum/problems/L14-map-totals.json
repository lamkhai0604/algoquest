  "level": 14,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 3,
  "title": "Map Totals",
  "statement": "A farm map is a grid of crop yields. For each query [r1, c1, r2, c2], return the total yield of the rectangle from row r1, column c1 to row r2, column c2, all included.",
  "examples": [
    {
      "input": "grid = [[3, 0, 1], [5, 6, 3], [1, 2, 0]], queries = [[1, 1, 2, 2], [0, 0, 0, 2]]",
      "output": "[11, 4]"
    },
    {
      "input": "grid = [[7]], queries = [[0, 0, 0, 0]]",
      "output": "[7]"
    }
  ],
  "constraints": [
    "1 <= rows, cols <= 200",
    "-1000 <= grid[r][c] <= 1000",
    "1 <= queries.length <= 10000"
  ],
  "answerKey": {
    "pattern": "2D prefix sums",
    "keyPoints": [
      "P[r + 1][c + 1] = grid[r][c] + P[r][c + 1] + P[r + 1][c] − P[r][c]",
      "Rectangle = P[r2+1][c2+1] − P[r1][c2+1] − P[r2+1][c1] + P[r1][c1]",
      "Build once in O(R · C), answer each query in O(1)"
    ],
    "timeComplexity": "O(R · C + q)",
    "spaceComplexity": "O(R · C)",
    "edgeCases": [
      "A single cell",
      "The whole grid",
      "A single row or column"
    ],
    "acceptableSlowerApproaches": [
      "Prefix sums per row, adding each row of the rectangle: O(R · C + q · R)",
      "Sum each rectangle directly: O(q · R · C)"
    ]
  },
  "hints": [
    "One dimension used running totals. What would a running total of a grid hold?",
    "P[r][c] = the total of the rectangle from (0, 0) to (r − 1, c − 1).",
    "Subtract the strip above and the strip to the left, then add back the corner that was subtracted twice."
  ],
  "starterCode": {
    "javascript": "function mapTotals(grid, queries) {\n  // return the total for each query\n}",
    "java": "class Solution {\n  int[] mapTotals(int[][] grid, int[][] queries) {\n    // return the total for each query\n  }\n}"
  },
