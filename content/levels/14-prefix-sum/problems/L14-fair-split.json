{
  "id": "L14-fair-split",
  "level": 14,
  "difficulty": "Easy",
  "use": "practice",
  "status": "ready",
  "order": 3,
  "title": "Fair Split",
  "statement": "Two teams split a row of prize boxes: team A takes boxes 0..i and team B takes boxes i + 1..n − 1, where both parts are non-empty. A split is fair to A when A's total is at least B's total. Return how many split points are fair to A.",
  "examples": [
    {
      "input": "boxes = [10, 4, -8, 7]",
      "output": "2"
    },
    {
      "input": "boxes = [2, 3, 1, 0]",
      "output": "2"
    }
  ],
  "constraints": [
    "2 <= boxes.length <= 100000",
    "-100000 <= boxes[i] <= 100000"
  ],
  "answerKey": {
    "pattern": "Total minus running prefix",
    "keyPoints": [
      "Compute the total once",
      "Walk the split point, keeping the left total",
      "Right total = total − left; count when left >= right",
      "Use 64-bit sums"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "Only one split point (n = 2)",
      "Negative values",
      "Equal totals count as fair"
    ],
    "acceptableSlowerApproaches": [
      "Sum both sides for every split: O(n²)"
    ]
  },
  "hints": [
    "For each split you need both totals. Which one can you get from the other?",
    "right = total − left, with the total computed once.",
    "Keep a running left total over i = 0..n − 2 and compare it with total − left."
  ],
  "starterCode": {
    "javascript": "function fairSplits(boxes) {\n  // return the number of fair splits\n}",
    "java": "class Solution {\n  int fairSplits(int[] boxes) {\n    // return the number of fair splits\n  }\n}"
  },
