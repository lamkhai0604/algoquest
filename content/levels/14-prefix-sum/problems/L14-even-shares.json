{
  "id": "L14-even-shares",
  "level": 14,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 2,
  "title": "Even Shares",
  "statement": "A team logs points scored in each round (penalties are negative). Return how many stretches of consecutive rounds have a total that can be shared evenly among k players, that is, a total divisible by k (0 counts).",
  "examples": [
    {
      "input": "points = [4, 5, 0, -2, -3, 1], k = 5",
      "output": "7"
    },
    {
      "input": "points = [5], k = 9",
      "output": "0"
    }
  ],
  "constraints": [
    "1 <= points.length <= 100000",
    "-10000 <= points[i] <= 10000",
    "2 <= k <= 10000"
  ],
  "answerKey": {
    "pattern": "Prefix sums with a hash map of remainders",
    "keyPoints": [
      "Two running totals with the same remainder mod k bound a stretch divisible by k",
      "Count remainders seen so far, starting with remainder 0 once",
      "Normalize negative remainders: ((t % k) + k) % k"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(k)",
    "edgeCases": [
      "Negative totals",
      "A stretch of one round",
      "Every total divisible"
    ],
    "acceptableSlowerApproaches": [
      "Check every stretch: O(n²)"
    ]
  },
  "hints": [
    "When is the total of points[j..i] divisible by k, in terms of two running totals?",
    "When the two running totals leave the same remainder after dividing by k.",
    "Count each remainder as you go (start with {0: 1}); add the count of the current remainder before increasing it. Fix negative remainders."
  ],
  "starterCode": {
    "javascript": "function evenShares(points, k) {\n  // return the number of stretches\n}",
    "java": "class Solution {\n  int evenShares(int[] points, int k) {\n    // return the number of stretches\n  }\n}"
  },
