{
  "id": "L14-coin-ranges",
  "level": 14,
  "difficulty": "Easy",
  "use": "practice",
  "status": "ready",
  "order": 1,
  "title": "Coin Ranges",
  "statement": "A game stores the coins a player earned each day (a loss is negative). For each query [l, r], return the total coins from day l to day r, both included.",
  "examples": [
    {
      "input": "coins = [3, 1, 4, 2, 5], queries = [[1, 3], [0, 4]]",
      "output": "[7, 15]"
    },
    {
      "input": "coins = [-2], queries = [[0, 0]]",
      "output": "[-2]"
    }
  ],
  "constraints": [
    "1 <= coins.length <= 100000",
    "-1000 <= coins[i] <= 1000",
    "1 <= queries.length <= 100000",
    "0 <= l <= r < coins.length"
  ],
  "answerKey": {
    "pattern": "Prefix sums for range queries",
    "keyPoints": [
      "Build prefix with prefix[0] = 0 and prefix[i + 1] = prefix[i] + coins[i]",
      "Answer each query as prefix[r + 1] − prefix[l]",
      "O(1) per query after O(n) to build"
    ],
    "timeComplexity": "O(n + q)",
    "spaceComplexity": "O(n)",
    "edgeCases": [
      "l = r",
      "The whole array",
      "Negative coins"
    ],
    "acceptableSlowerApproaches": [
      "Sum each range directly: O(q · n)"
    ]
  },
  "hints": [
    "Many queries on the same data that never changes. What could you compute once?",
    "A running total up to each day. How do two running totals give a range?",
    "prefix[r + 1] − prefix[l]: everything up to r minus everything before l."
  ],
  "starterCode": {
    "javascript": "function coinRanges(coins, queries) {\n  // return the total for each query\n}",
    "java": "class Solution {\n  int[] coinRanges(int[] coins, int[][] queries) {\n    // return the total for each query\n  }\n}"
  },
