  "order": 2,
  "title": "Starting Energy",
  "statement": "A hiker's energy changes by gains[i] at each checkpoint, in order (a climb is negative). She starts with some positive whole number of energy points, and her energy must stay at least 1 after every checkpoint. Return the smallest starting energy that works.",
  "examples": [
    {
      "input": "gains = [-3, 2, -3, 4, 2]",
      "output": "5"
    },
    {
      "input": "gains = [1, 2]",
      "output": "1"
    }
  ],
  "constraints": [
    "1 <= gains.length <= 100000",
    "-100 <= gains[i] <= 100"
  ],
  "answerKey": {
    "pattern": "Running total: the lowest prefix sum",
    "keyPoints": [
      "Track the running total of gains",
      "Find its lowest value",
      "The start must be at least 1 − lowest, and at least 1"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "All gains positive: 1",
      "The lowest point is at the end",
      "A single checkpoint"
    ],
    "acceptableSlowerApproaches": [
      "Try starting values 1, 2, 3, … and simulate each: O(n · answer)"
    ]
  },
  "hints": [
    "Energy after checkpoint i is the start plus the running total up to i. When is it smallest?",
    "At the lowest running total.",
    "Start = max(1, 1 − lowest running total)."
  ],
  "starterCode": {
    "javascript": "function startingEnergy(gains) {\n  // return the smallest starting energy\n}",
    "java": "class Solution {\n  int startingEnergy(int[] gains) {\n    // return the smallest starting energy\n  }\n}"
