{
  "id": "L14-vowel-words",
  "level": 14,
  "difficulty": "Easy",
  "use": "test",
  "status": "ready",
  "title": "Vowel Words",
  "statement": "A word list is numbered from 0. A word is special when it starts and ends with a vowel (a, e, i, o, u). For each query [l, r], return how many special words are among words l to r.",
  "examples": [
    {
      "input": "words = [\"aba\", \"bcb\", \"ece\", \"aa\", \"e\"], queries = [[0, 2], [1, 4], [1, 1]]",
      "output": "[2, 3, 0]"
    },
    {
      "input": "words = [\"a\"], queries = [[0, 0]]",
      "output": "[1]"
    }
  ],
  "constraints": [
    "1 <= words.length <= 100000",
    "1 <= words[i].length <= 40",
    "1 <= queries.length <= 100000"
  ],
  "answerKey": {
    "pattern": "Prefix counts",
    "keyPoints": [
      "Mark each word 1 if special, else 0",
      "Prefix sums of the marks",
      "Answer each query as prefix[r + 1] − prefix[l]"
    ],
    "timeComplexity": "O(n + q)",
    "spaceComplexity": "O(n)",
    "edgeCases": [
      "One-letter words",
      "No special words",
      "l = r"
    ],
    "acceptableSlowerApproaches": [
      "Count each range directly: O(q · n)"
    ]
  },
  "hints": [
    "Each query counts something in a range of a list that never changes.",
    "Turn the list into 0s and 1s, then use running totals.",
    "prefix[r + 1] − prefix[l] counts the special words in l..r."
  ],
  "starterCode": {
    "javascript": "function vowelWords(words, queries) {\n  // return the count for each query\n}",
    "java": "class Solution {\n  int[] vowelWords(String[] words, int[][] queries) {\n    // return the count for each query\n  }\n}"
  },
  "similarLeetCode": "Count Vowel Strings in Ranges",
