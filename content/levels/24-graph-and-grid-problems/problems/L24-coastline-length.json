{
  "id": "L24-coastline-length",
  "level": 24,
  "difficulty": "Easy",
  "use": "practice",
  "status": "ready",
  "order": 1,
  "title": "Coastline Length",
  "statement": "A map grid marks land with 1 and water with 0, and the outside of the map is water. Return the total length of coastline: the number of land cell sides that touch water or the edge of the map.",
  "examples": [
    {
      "input": "map = [[0, 1, 0, 0], [1, 1, 1, 0], [0, 1, 0, 0], [1, 1, 0, 0]]",
      "output": "16"
    },
    {
      "input": "map = [[1]]",
      "output": "4"
    }
  ],
  "constraints": [
    "1 <= rows, columns <= 100",
    "map[r][c] is 0 or 1"
  ],
  "answerKey": {
    "pattern": "Count sides: every land cell adds 4, minus 2 for each pair of land neighbours",
    "keyPoints": [
      "Visit every cell once; no search is needed",
      "For each land cell, count the sides whose neighbour is water or outside",
      "Or: 4 × land − 2 × shared edges"
    ],
    "timeComplexity": "O(rows · columns)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "No land: 0",
      "One land cell: 4",
      "Land touching the map edge"
    ],
    "acceptableSlowerApproaches": [
      "DFS over each island: also O(rows · columns), more code"
    ]
  },
  "hints": [
    "Do you need to search, or just look at each cell?",
    "A side is coastline when the neighbour across it is water or off the map.",
    "Sum, over land cells, the number of the four neighbours that are not land."
  ],
  "starterCode": {
    "javascript": "function coastlineLength(map) {\n  // return the coastline length\n}",
    "java": "class Solution {\n  int coastlineLength(int[][] map) {\n    // return the coastline length\n  }\n}"
  },
