  "use": "practice",
  "status": "ready",
  "order": 2,
  "title": "Dial Lock",
  "statement": "A lock has four dials, each showing a digit 0–9, and starts at \"0000\". One move turns one dial one step up or down (9 wraps to 0 and 0 to 9). Some combinations jam the lock and must never be shown. Return the fewest moves to reach target, or −1 if it cannot be reached.",
  "examples": [
    {
      "input": "jams = [\"0201\", \"0101\", \"0102\", \"1212\", \"2002\"], target = \"0202\"",
      "output": "6"
    },
    {
      "input": "jams = [\"0000\"], target = \"8888\"",
      "output": "-1"
    }
  ],
  "constraints": [
    "0 <= jams.length <= 500",
    "jams[i] and target have 4 digits",
    "target is not a jam"
  ],
  "answerKey": {
    "pattern": "BFS over the 10,000 states, skipping jammed states",
    "keyPoints": [
      "Each combination is a vertex with 8 neighbours",
      "Put the jams in a set; if \"0000\" is jammed, return −1",
      "BFS level by level until the target appears"
    ],
    "timeComplexity": "O(10⁴ · 8)",
    "spaceComplexity": "O(10⁴)",
    "edgeCases": [
      "Target is \"0000\": 0",
      "Start jammed: −1",
      "Target fully surrounded by jams: −1"
    ],
    "acceptableSlowerApproaches": [
      "DFS: does not give the fewest moves",
      "Turn each dial straight to its digit: ignores jams"
    ]
  },
  "hints": [
    "What are the vertices? How many neighbours does each have?",
    "10,000 combinations, each with 8 neighbours (4 dials × up or down).",
    "BFS from \"0000\"; never enqueue a jammed or already-seen combination."
  ],
  "starterCode": {
    "javascript": "function dialLock(jams, target) {\n  // return the fewest moves or -1\n}",
    "java": "class Solution {\n  int dialLock(String[] jams, String target) {\n    // return the fewest moves or -1\n  }\n}"
  },
