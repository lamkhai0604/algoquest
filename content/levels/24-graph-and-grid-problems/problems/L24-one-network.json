{
  "id": "L24-one-network",
  "level": 24,
  "difficulty": "Easy",
  "use": "test",
  "status": "ready",
  "title": "One Network",
  "statement": "A town has n houses numbered 0 to n − 1 and a list of two-way paths between them. Return true if the paths form a tree: every house can reach every other house, and there is exactly one route between any two houses.",
  "examples": [
    {
      "input": "n = 5, paths = [[0, 1], [0, 2], [0, 3], [1, 4]]",
      "output": "true"
    },
    {
      "input": "n = 5, paths = [[0, 1], [1, 2], [2, 3], [1, 3], [1, 4]]",
      "output": "false"
    }
  ],
  "constraints": [
    "1 <= n <= 2000",
    "0 <= paths.length <= 5000",
    "no repeated path, no path from a house to itself"
  ],
  "answerKey": {
    "pattern": "A tree has exactly n − 1 edges and no cycle: check the count, then union-find",
    "keyPoints": [
      "If the number of paths is not n − 1, return false",
      "Union the ends of each path; a path inside one group makes a cycle",
      "With n − 1 paths and no cycle, everything is connected"
    ],
    "timeComplexity": "O(n · α(n))",
    "spaceComplexity": "O(n)",
    "edgeCases": [
      "n = 1 with no paths: true",
      "Enough paths but two groups",
      "A cycle plus a separate house"
    ],
    "acceptableSlowerApproaches": [
      "DFS from house 0 counting visited houses and checking for back edges: O(n + m)"
    ]
  },
  "hints": [
    "How many edges does a tree on n vertices have?",
    "Exactly n − 1. With that count, connected and acyclic mean the same thing.",
    "Check the count, then union-find: any path whose ends are already joined means false."
  ],
  "starterCode": {
    "javascript": "function oneNetwork(n, paths) {\n  // return whether the paths form a tree\n}",
    "java": "class Solution {\n  boolean oneNetwork(int n, int[][] paths) {\n    // return whether the paths form a tree\n  }\n}"
  },
