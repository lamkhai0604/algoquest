{
  "id": "L22-everyone-elses-product",
  "level": 22,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 1,
  "title": "Everyone Else's Product",
  "statement": "Each team member has a score. For every member, return the product of all the other members' scores. Division is not allowed. The answers fit in a 32-bit integer.",
  "examples": [
    {
      "input": "scores = [1, 2, 3, 4]",
      "output": "[24, 12, 8, 6]"
    },
    {
      "input": "scores = [-1, 1, 0, -3, 3]",
      "output": "[0, 0, 9, 0, 0]"
    }
  ],
  "constraints": [
    "2 <= scores.length <= 10^5",
    "-30 <= scores[i] <= 30",
    "Every product fits in a 32-bit integer"
  ],
  "answerKey": {
    "pattern": "Prefix and suffix products",
    "keyPoints": [
      "answer[i] = product of everything before i × product of everything after i",
      "Fill prefix products left to right into the answer",
      "Multiply in suffix products right to left with one running variable"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1) besides the output",
    "edgeCases": [
      "A zero",
      "Two zeros: all answers 0",
      "Negative scores"
    ],
    "acceptableSlowerApproaches": [
      "Multiply all others for each member: O(n²)",
      "Divide the total product: not allowed and fails with zeros"
    ]
  },
  "hints": [
    "What is the product of everyone except member i, in two parts?",
    "Everything to the left times everything to the right.",
    "One pass for left products into the answer, a second pass from the right with a running suffix product."
  ],
  "starterCode": {
    "javascript": "function everyoneElsesProduct(scores) {\n  // return the products\n}",
    "java": "class Solution {\n  int[] everyoneElsesProduct(int[] scores) {\n    // return the products\n  }\n}"
  },
