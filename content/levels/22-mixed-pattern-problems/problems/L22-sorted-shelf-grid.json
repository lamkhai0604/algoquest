  "title": "Sorted Shelf Grid",
  "statement": "A warehouse stores boxes on a grid of shelves. Box numbers never decrease from left to right along a row, and never decrease from top to bottom along a column. Return true if box number target is somewhere on the grid.",
  "examples": [
    {
      "input": "grid = [[1, 4, 7], [2, 5, 8], [3, 6, 9]], target = 5",
      "output": "true"
    },
    {
      "input": "grid = [[1, 4, 7], [2, 5, 8], [3, 6, 9]], target = 10",
      "output": "false"
    }
  ],
  "constraints": [
    "1 <= rows, columns <= 300",
    "-10^9 <= grid[r][c], target <= 10^9"
  ],
  "answerKey": {
    "pattern": "Staircase search from the top-right corner",
    "keyPoints": [
      "At the top-right, everything left is smaller and everything below is larger",
      "If the box is bigger than target move left, if smaller move down",
      "Each step removes a whole row or column"
    ],
    "timeComplexity": "O(rows + columns)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "One cell",
      "Target smaller than everything",
      "Target larger than everything"
    ],
    "acceptableSlowerApproaches": [
      "Binary search each row: O(rows · log columns)",
      "Scan every cell: O(rows · columns)"
    ]
  },
  "hints": [
    "Which corner lets one comparison rule out a whole row or a whole column?",
    "At the top-right corner, moving left makes values smaller and moving down makes them larger.",
    "Start top-right; while inside the grid: equal → true, bigger → column − 1, smaller → row + 1."
  ],
  "starterCode": {
    "javascript": "function sortedShelfGrid(grid, target) {\n  // return whether target is on the grid\n}",
    "java": "class Solution {\n  boolean sortedShelfGrid(int[][] grid, int target) {\n    // return whether target is on the grid\n  }\n}"
  },
