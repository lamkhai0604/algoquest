{
  "id": "L22-flower-bed",
  "level": 22,
  "difficulty": "Easy",
  "use": "test",
  "status": "ready",
  "title": "Flower Bed",
  "statement": "A garden bed is a row of plots, 1 for planted and 0 for empty. No two flowers may be in neighbouring plots, and the bed already follows this rule. Return true if k new flowers can be planted without breaking the rule.",
  "examples": [
    {
      "input": "bed = [1, 0, 0, 0, 1], k = 1",
      "output": "true"
    },
    {
      "input": "bed = [1, 0, 0, 0, 1], k = 2",
      "output": "false"
    }
  ],
  "constraints": [
    "1 <= bed.length <= 2 * 10^4",
    "bed[i] is 0 or 1 with no two 1s next to each other",
    "0 <= k <= bed.length"
  ],
  "answerKey": {
    "pattern": "Greedy left to right: plant whenever a plot and both neighbours are empty",
    "keyPoints": [
      "Planting as early as possible never blocks a better plan",
      "Treat the ends as having empty neighbours outside",
      "Stop early once k flowers fit"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1) besides a copy",
    "edgeCases": [
      "k = 0: true",
      "One plot",
      "Empty bed"
    ],
    "acceptableSlowerApproaches": [
      "Try every set of plots: exponential"
    ]
  },
  "hints": [
    "When can a flower go in plot i?",
    "When plot i and both neighbours are empty (or outside the bed).",
    "Walk left to right, plant whenever possible, and count."
  ],
  "starterCode": {
    "javascript": "function flowerBed(bed, k) {\n  // return whether k flowers fit\n}",
    "java": "class Solution {\n  boolean flowerBed(int[] bed, int k) {\n    // return whether k flowers fit\n  }\n}"
  },
  "similarLeetCode": "Can Place Flowers",
