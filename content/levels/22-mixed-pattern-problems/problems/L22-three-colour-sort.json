{
  "id": "L22-three-colour-sort",
  "level": 22,
  "difficulty": "Easy",
  "use": "practice",
  "status": "ready",
  "order": 3,
  "title": "Three-Colour Sort",
  "statement": "A row of paint tins is labelled 0 (red), 1 (white) or 2 (blue). Return the labels in order, all 0s first, then 1s, then 2s, using a single pass over the row and no extra list of the same size.",
  "examples": [
    {
      "input": "tins = [2, 0, 2, 1, 1, 0]",
      "output": "[0, 0, 1, 1, 2, 2]"
    },
    {
      "input": "tins = [2, 0, 1]",
      "output": "[0, 1, 2]"
    }
  ],
  "constraints": [
    "1 <= tins.length <= 300",
    "tins[i] is 0, 1 or 2"
  ],
  "answerKey": {
    "pattern": "Three pointers (Dutch national flag): low, mid, high",
    "keyPoints": [
      "Everything before low is 0, after high is 2",
      "Scan with mid: swap 0s to low, 2s to high, skip 1s",
      "Do not advance mid after swapping with high"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "All one colour",
      "Already sorted",
      "Reverse sorted"
    ],
    "acceptableSlowerApproaches": [
      "Count each colour and rewrite: O(n), two passes",
      "Any sort: O(n log n)"
    ]
  },
  "hints": [
    "Only three values exist. Where should each go?",
    "Keep a boundary for the 0s at the front and one for the 2s at the back.",
    "Walk mid: 0 → swap with low (both move), 2 → swap with high (only high moves), 1 → mid moves."
  ],
  "starterCode": {
    "javascript": "function threeColourSort(tins) {\n  // return the sorted labels\n}",
    "java": "class Solution {\n  int[] threeColourSort(int[] tins) {\n    // return the sorted labels\n  }\n}"
  },
