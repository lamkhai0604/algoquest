      "output": "2"
    }
  ],
  "constraints": [
    "1 <= votes.length <= 5 * 10^4",
    "1 <= votes[i] <= 10^9",
    "A candidate with more than half the votes always exists"
  ],
  "answerKey": {
    "pattern": "Counting: a hash map of counts, or Boyer–Moore voting in O(1) space",
    "keyPoints": [
      "Count votes per candidate and return the one above n / 2",
      "Or keep a candidate and a counter: +1 for the same vote, −1 otherwise, switch when the counter is 0",
      "The majority always survives the cancellations"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1) with voting, O(n) with a map",
    "edgeCases": [
      "One vote",
      "All votes the same",
      "Majority by exactly one vote"
    ],
    "acceptableSlowerApproaches": [
