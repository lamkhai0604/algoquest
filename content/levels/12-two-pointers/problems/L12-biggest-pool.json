    {
      "input": "[1, 8, 6, 2, 5, 4, 8, 3, 7]",
      "output": "49",
      "explanation": "Walls at index 1 and 8: width 7, height 7, water 49."
    },
    {
      "input": "[2, 2]",
      "output": "2"
    }
  ],
  "constraints": [
    "2 <= heights.length <= 10^5",
    "0 <= heights[i] <= 10^4"
  ],
  "answerKey": {
    "pattern": "Two pointers from both ends, moving the shorter wall inward",
    "keyPoints": [
      "left = 0, right = last index; area = (right - left) * min(heights)",
      "Keep the best area",
      "Move the pointer at the shorter wall inward: the shorter wall cannot do better with a narrower width",
      "Stop when the pointers meet"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "Two walls only",
      "Equal heights",
      "Walls of height 0"
    ],
    "acceptableSlowerApproaches": [
      "Try every pair of walls: O(n^2)"
    ]
  },
  "hints": [
    "Trying every pair is O(n^2). Start with the widest pair: which wall limits it?",
    "The shorter wall limits the water. Moving the taller one inward can only make things worse.",
    "So move the pointer at the shorter wall and keep the best area seen."
  ],
