  "status": "ready",
  "order": 2,
  "title": "Sorted Squares",
  "statement": "Given integers sorted in ascending order (they may be negative), return the squares of the numbers, also in ascending order, in O(n) time.",
  "examples": [
    {
      "input": "[-4, -1, 0, 3, 10]",
      "output": "[0, 1, 9, 16, 100]"
    },
    {
      "input": "[-7, -3, 2, 3, 11]",
      "output": "[4, 9, 9, 49, 121]"
    }
  ],
  "constraints": [
    "0 <= nums.length <= 10^5",
    "nums is sorted ascending"
  ],
  "answerKey": {
    "pattern": "Two pointers at both ends, filling the result from the back",
    "keyPoints": [
      "The largest square is at one of the two ends",
      "Compare the squares at left and right, write the larger at the end of the result",
      "Move that pointer inward and fill the next position from the back"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(n) for the result",
    "edgeCases": [
      "All negative numbers",
      "All non-negative numbers",
      "Empty input"
    ],
    "acceptableSlowerApproaches": [
      "Square everything and sort: O(n log n)"
    ]
  },
  "hints": [
    "Squaring and sorting is O(n log n). Where can the largest square be?",
    "Only at the far left (a big negative) or the far right.",
    "Fill the result from the last position backwards."
  ],
