  "level": 12,
  "difficulty": "Easy",
  "use": "practice",
  "status": "ready",
  "order": 3,
  "title": "Merge Two Score Lists",
  "statement": "Two teams each have a list of scores sorted in ascending order. Return one list with all scores, still in ascending order, without sorting again.",
  "examples": [
    {
      "input": "[1, 4, 9], [2, 3, 10]",
      "output": "[1, 2, 3, 4, 9, 10]"
    },
    {
      "input": "[], [5]",
      "output": "[5]"
    }
  ],
  "constraints": [
    "0 <= a.length, b.length <= 10^5",
    "both lists are sorted ascending"
  ],
  "answerKey": {
    "pattern": "Two pointers, one per list, always taking the smaller front value",
    "keyPoints": [
      "i = 0 in the first list, j = 0 in the second",
      "Append the smaller of a[i] and b[j] and move that pointer",
      "When one list ends, append the rest of the other"
    ],
    "timeComplexity": "O(n + m)",
    "spaceComplexity": "O(n + m) for the result",
    "edgeCases": [
      "One list empty",
      "Equal values in both lists",
      "One list much longer than the other"
    ],
    "acceptableSlowerApproaches": [
      "Concatenate and sort: O((n + m) log(n + m))"
    ]
  },
  "hints": [
    "Sorting again ignores that both lists are already sorted. Where is the smallest remaining score?",
    "It is at the front of one of the two lists: compare a[i] and b[j].",
    "Do not forget the leftover scores when one list runs out."
  ],
