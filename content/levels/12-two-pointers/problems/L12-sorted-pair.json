{
  "id": "L12-sorted-pair",
  "level": 12,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 1,
  "title": "Sorted Pair Target",
  "statement": "Given an array of integers sorted in ascending order and a target, return the indices [i, j] (i < j) of two numbers that add up to the target. At most one pair adds up to the target. If no pair exists, return [-1, -1]. Use O(1) extra space.",
  "examples": [
    {
      "input": "[-4, 1, 3, 8, 11], 9",
      "output": "[1, 3]"
    },
    {
      "input": "[1, 2, 4], 10",
      "output": "[-1, -1]"
    }
  ],
  "constraints": [
    "2 <= nums.length <= 10^5",
    "nums is sorted ascending"
  ],
  "answerKey": {
    "pattern": "Two pointers at opposite ends, using the sorted order",
    "keyPoints": [
      "left = 0, right = last index",
      "If nums[left] + nums[right] == target return [left, right]",
      "If the sum is smaller, move left forward (increase the sum)",
      "If the sum is larger, move right backward (decrease the sum)",
      "If the pointers meet, return [-1, -1]"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "No valid pair returns [-1, -1]",
      "Negative numbers",
      "Duplicate values"
    ],
    "acceptableSlowerApproaches": [
      "Hash map complement lookup: O(n) time but O(n) space, ignores the sorted order and the O(1) space requirement"
    ]
  },
  "hints": [
    "A hash map works but uses O(n) space. What does the sorted order tell you?",
    "Start with the smallest and the largest number and look at their sum.",
    "Too small: move the left pointer right. Too big: move the right pointer left."
  ],
  "starterCode": {
    "javascript": "function sortedPair(nums, target) {\n  // return [i, j] or [-1, -1]\n}",
    "java": "class Solution {\n  int[] sortedPair(int[] nums, int target) {\n    // return {i, j} or {-1, -1}\n  }\n}"
  },
