  "order": 1,
  "title": "Count the Stops",
  "statement": "A night bus route is stored as a linked list: each node holds a stop number and points to the next stop. You get the first node, `head` (null if the route has no stops). Return how many stops the route has.",
  "examples": [
    {
      "input": "head = 4 → 9 → 2",
      "output": "3"
    },
    {
      "input": "head = null",
      "output": "0"
    }
  ],
  "constraints": [
    "0 <= number of stops <= 10^5",
    "0 <= stop number <= 10^4"
  ],
  "answerKey": {
    "pattern": "Walk the list from head to null",
    "keyPoints": [
      "Start a pointer at head and a counter at 0",
      "While the pointer is not null, count the node and move to node.next",
      "Stop when the pointer becomes null; the counter is the answer"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "Empty route (head is null)",
      "A route with one stop"
    ],
    "acceptableSlowerApproaches": []
  },
  "hints": [
    "A linked list has no length you can read. How do you reach every node?",
    "Keep a pointer that starts at head and moves with node = node.next.",
    "Count each node you visit and stop when the pointer is null."
  ],
  "starterCode": {
    "javascript": "// A node is { val, next }. Make one with new ListNode(val, next).\nfunction countStops(head) {\n  // return the number of nodes\n}",
