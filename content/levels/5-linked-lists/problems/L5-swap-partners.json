{
  "id": "L5-swap-partners",
  "level": 5,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 2,
  "title": "Swap Dance Partners",
  "statement": "Dancers stand in a line stored as a linked list of badge numbers. At the music cue, the 1st and 2nd dancer swap places, then the 3rd and 4th, and so on. If the count is odd, the last dancer stays. Swap the nodes themselves (change pointers, not the values) and return the new head.",
  "examples": [
    {
      "input": "head = 1 → 2 → 3 → 4",
      "output": "2 → 1 → 4 → 3"
    },
    {
      "input": "head = 5 → 6 → 7",
      "output": "6 → 5 → 7"
    }
  ],
  "constraints": [
    "0 <= number of dancers <= 10^5",
    "0 <= badge number <= 10^4",
    "Do not change the values in the nodes"
  ],
  "answerKey": {
    "pattern": "Pairwise relinking with a dummy node in front",
    "keyPoints": [
      "Put a dummy node before head and a pointer prev at it",
      "While prev.next and prev.next.next exist, call them first and second",
      "Relink: first.next = second.next, second.next = first, prev.next = second",
      "Move prev to first, which is now the second of the pair",
      "Return dummy.next"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "Empty list or one node",
      "Odd number of nodes",
      "Two nodes"
    ],
    "acceptableSlowerApproaches": [
      "Recursion on the rest of the list: O(n) time and O(n) call stack"
    ]
  },
  "hints": [
    "Draw two nodes and the node before them. Which three pointers change when they swap?",
    "A dummy node in front of head means the first pair has a node before it too.",
    "Set first.next = second.next, then second.next = first, then prev.next = second. Then prev moves to first."
  ],
  "starterCode": {
    "javascript": "// A node is { val, next }. Make one with new ListNode(val, next).\nfunction swapPartners(head) {\n  // return the head after swapping each pair\n}",
    "java": "// ListNode has: int val; ListNode next; and new ListNode(val) or new ListNode(val, next).\nclass Solution {\n  ListNode swapPartners(ListNode head) {\n    // return the head after swapping each pair\n  }\n}"
  },
