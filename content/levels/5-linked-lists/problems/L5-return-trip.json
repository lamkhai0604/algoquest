  "status": "ready",
  "order": 3,
  "title": "Return Trip",
  "statement": "A ferry's route is a linked list of port numbers from the first port to the last. On the way back the ferry visits the same ports in reverse order. Reverse the list in place, without creating new nodes, and return the new head.",
  "examples": [
    {
      "input": "head = 1 → 4 → 6",
      "output": "6 → 4 → 1"
    },
    {
      "input": "head = 8",
      "output": "8"
    }
  ],
  "constraints": [
    "0 <= number of ports <= 10^5",
    "0 <= port number <= 10^4",
    "Reuse the existing nodes"
  ],
  "answerKey": {
    "pattern": "In-place reversal with prev, curr, and a saved next pointer",
    "keyPoints": [
      "Start with prev = null and curr = head",
      "Save curr.next before changing anything",
      "Point curr.next back to prev",
      "Move prev to curr and curr to the saved node",
      "When curr is null, prev is the new head"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "Empty list",
      "One node",
      "Two nodes"
    ],
    "acceptableSlowerApproaches": [
      "Recursion: O(n) time but O(n) call stack",
      "Copy values to an array and write them back reversed: O(n) extra space"
    ]
  },
  "hints": [
    "Each arrow has to turn around. Which node should the first node point to at the end?",
    "Walk with two pointers, prev and curr. What happens to the rest of the list when you change curr.next?",
    "Save curr.next in a variable first, then set curr.next = prev, then move both pointers one step."
  ],
  "starterCode": {
    "javascript": "// A node is { val, next }. Make one with new ListNode(val, next).\nfunction returnTrip(head) {\n  // return the head of the reversed list\n}",
