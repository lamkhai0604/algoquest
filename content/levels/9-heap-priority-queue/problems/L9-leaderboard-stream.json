{
  "id": "L9-leaderboard-stream",
  "level": 9,
  "difficulty": "Easy",
  "use": "test",
  "status": "ready",
  "title": "Live Leaderboard",
  "statement": "A live game shows the `k`-th highest score so far. It starts with the scores in `start`, then new scores arrive one by one in `incoming`. After each new score, record the current k-th highest score. Return the recorded values. There are always at least k scores once the first new score has arrived.",
  "examples": [
    {
      "input": "k = 3, start = [4, 5, 8, 2], incoming = [3, 5, 10, 9, 4]",
      "output": "[4, 5, 5, 8, 8]"
    },
    {
      "input": "k = 1, start = [], incoming = [-3, -2, -4]",
      "output": "[-3, -2, -2]"
    }
  ],
  "constraints": [
    "1 <= k <= 10^4",
    "0 <= start.length, incoming.length <= 10^4",
    "-10^4 <= score <= 10^4"
  ],
  "answerKey": {
    "pattern": "Min-heap holding the k highest scores; its root is the answer after each arrival",
    "keyPoints": [
      "Push the starting scores, popping whenever the heap has more than k",
      "For each new score: push, pop if the size is over k, record the root",
      "Each arrival costs O(log k)"
    ],
    "timeComplexity": "O((n + m) log k)",
    "spaceComplexity": "O(k)",
    "edgeCases": [
      "Empty start list",
      "k = 1",
      "New scores lower than every kept score"
    ],
    "acceptableSlowerApproaches": [
      "Sort all scores after every arrival: O(m n log n)"
    ]
  },
  "hints": [
    "After each arrival you need the k-th highest. Which scores can you forget forever?",
    "Only the k highest scores matter. Keep them in a min-heap: its smallest is the k-th highest.",
    "Push each new score, pop if the heap holds more than k, then read the root."
  ],
  "starterCode": {
    "javascript": "function liveLeaderboard(k, start, incoming) {\n  // return the k-th highest score after each new score\n}",
    "java": "class Solution {\n  int[] liveLeaderboard(int k, int[] start, int[] incoming) {\n    // return the k-th highest score after each new score\n  }\n}"
  },
