  "order": 1,
  "title": "K-th Place Score",
  "statement": "A game show records every contestant's score in `scores`. Return the score in `k`-th place, counting from the highest (k = 1 is the top score). Equal scores take separate places. Try a heap that keeps only the k highest scores.",
  "examples": [
    {
      "input": "scores = [40, 75, 10, 90, 75], k = 2",
      "output": "75"
    },
    {
      "input": "scores = [5], k = 1",
      "output": "5"
    }
  ],
  "constraints": [
    "1 <= k <= scores.length <= 10^5",
    "-10^4 <= scores[i] <= 10^4"
  ],
  "answerKey": {
    "pattern": "Min-heap of size k: the root is the k-th largest",
    "keyPoints": [
      "Keep a min-heap of the k largest scores seen so far",
      "Push each score; if the heap grows past k, pop the smallest",
      "After all scores, the root is the k-th largest"
    ],
    "timeComplexity": "O(n log k)",
    "spaceComplexity": "O(k)",
    "edgeCases": [
      "k = 1",
      "k = n",
      "Equal scores",
      "Negative scores"
    ],
    "acceptableSlowerApproaches": [
      "Sort descending and take index k - 1: O(n log n)"
    ]
  },
  "hints": [
    "If you kept only the k highest scores, which of them is the answer?",
    "The smallest of the k highest scores is the k-th place. Which structure gives the smallest quickly?",
    "Use a min-heap: push each score and pop whenever it holds more than k."
  ],
  "starterCode": {
    "javascript": "function kthPlace(scores, k) {\n  // return the k-th highest score\n}",
    "java": "class Solution {\n  int kthPlace(int[] scores, int k) {\n    // return the k-th highest score\n  }\n}"
  },
