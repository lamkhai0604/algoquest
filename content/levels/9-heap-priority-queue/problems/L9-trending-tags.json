{
  "id": "L9-trending-tags",
  "level": 9,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 2,
  "title": "Trending Tags",
  "statement": "A photo app logs the tag ID of every post in `tags`. Return the `k` tags used most often, from most to least used; if two tags are used equally often, the smaller ID comes first.",
  "examples": [
    {
      "input": "tags = [4, 1, 4, 2, 2, 4], k = 2",
      "output": "[4, 2]"
    },
    {
      "input": "tags = [7, 3], k = 2",
      "output": "[3, 7]"
    }
  ],
  "constraints": [
    "1 <= tags.length <= 10^5",
    "1 <= k <= number of different tags",
    "0 <= tag ID <= 10^4"
  ],
  "answerKey": {
    "pattern": "Count with a hash map, then a heap of size k (or bucket by count)",
    "keyPoints": [
      "Count each tag with a hash map: O(n)",
      "Keep a min-heap of size k ordered by (count, then larger ID first), so the weakest candidate is on top",
      "Pop when it grows past k; sort the survivors by count descending, ID ascending"
    ],
    "timeComplexity": "O(n + m log k) for m different tags",
    "spaceComplexity": "O(m)",
    "edgeCases": [
      "Ties in count",
      "k equal to the number of different tags",
      "A single tag"
    ],
    "acceptableSlowerApproaches": [
      "Sort all (tag, count) pairs: O(n + m log m)",
      "Bucket sort by count: O(n), also excellent"
    ]
  },
  "hints": [
    "First you need how often each tag appears. Which structure from Level 3 counts things?",
    "Out of the counted tags, keep only the best k. Which one should be thrown out first?",
    "A min-heap of size k by (count, then ID reversed) keeps the k best; sort them for the final order."
  ],
  "starterCode": {
    "javascript": "function trendingTags(tags, k) {\n  // return the k most used tag IDs\n}",
    "java": "class Solution {\n  int[] trendingTags(int[] tags, int k) {\n    // return the k most used tag IDs\n  }\n}"
  },
