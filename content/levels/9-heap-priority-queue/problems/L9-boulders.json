  "use": "practice",
  "status": "ready",
  "order": 2,
  "title": "Boulder Crusher",
  "statement": "A quarry machine takes the two heaviest boulders from the pile each turn and smashes them together. If they weigh the same, both turn to dust. Otherwise the lighter one turns to dust and the heavier one loses that much weight and goes back on the pile. When at most one boulder is left, return its weight, or 0 if none is left.",
  "examples": [
    {
      "input": "weights = [2, 7, 4, 1, 8, 1]",
      "output": "1"
    },
    {
      "input": "weights = [3, 3]",
      "output": "0"
    }
  ],
  "constraints": [
    "1 <= weights.length <= 1000",
    "1 <= weights[i] <= 1000"
  ],
  "answerKey": {
    "pattern": "Max-heap: repeatedly take the two largest",
    "keyPoints": [
      "Put all weights in a max-heap",
      "While at least two remain, pop the two heaviest",
      "If they differ, push the difference back",
      "Return the last weight or 0"
    ],
    "timeComplexity": "O(n log n)",
    "spaceComplexity": "O(n)",
    "edgeCases": [
      "One boulder",
      "All equal pairs",
      "The remainder becomes the heaviest again"
    ],
    "acceptableSlowerApproaches": [
      "Sort the whole pile again every turn: O(n^2 log n)"
    ]
  },
  "hints": [
    "Every turn needs the two heaviest boulders. Which structure gives the largest item quickly, again and again?",
    "A max-heap. In JavaScript, a min-heap of negated weights works as a max-heap.",
    "Pop two, push back their difference if it is not 0, and repeat while two or more remain."
  ],
  "starterCode": {
    "javascript": "function boulderCrusher(weights) {\n  // return the last weight, or 0\n}",
    "java": "class Solution {\n  int boulderCrusher(int[] weights) {\n    // return the last weight, or 0\n  }\n}"
  },
