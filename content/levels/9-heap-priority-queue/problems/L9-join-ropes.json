  "order": 3,
  "title": "Join the Ropes",
  "statement": "A sailor has ropes of the lengths in `ropes` and wants one long rope. Joining two ropes of lengths a and b costs a + b and makes one rope of length a + b. Return the smallest total cost to join all ropes into one.",
  "examples": [
    {
      "input": "ropes = [4, 3, 2, 6]",
      "output": "29",
      "explanation": "2+3=5 (cost 5), 4+5=9 (cost 9), 6+9=15 (cost 15)"
    },
    {
      "input": "ropes = [7]",
      "output": "0"
    }
  ],
  "constraints": [
    "1 <= ropes.length <= 10^4",
    "1 <= ropes[i] <= 1000",
    "The answer fits in a 32-bit integer"
  ],
  "answerKey": {
    "pattern": "Greedy with a min-heap: always join the two shortest ropes",
    "keyPoints": [
      "Long ropes should be part of as few joins as possible, so join the shortest first",
      "Put all lengths in a min-heap",
      "Pop the two shortest, add their sum to the cost, push the sum back",
      "Stop when one rope is left"
    ],
    "timeComplexity": "O(n log n)",
    "spaceComplexity": "O(n)",
    "edgeCases": [
      "A single rope (cost 0)",
      "Two ropes",
      "All ropes the same length"
    ],
    "acceptableSlowerApproaches": [
      "Sort the list again after every join: O(n^2 log n)"
    ]
  },
  "hints": [
    "A rope that is joined early is paid for again in every later join. Which ropes should be joined first?",
    "Always join the two shortest ropes you have.",
    "A min-heap gives the two shortest quickly; push each new rope back in."
  ],
  "starterCode": {
    "javascript": "function joinRopes(ropes) {\n  // return the smallest total cost\n}",
    "java": "class Solution {\n  int joinRopes(int[] ropes) {\n    // return the smallest total cost\n  }\n}"
