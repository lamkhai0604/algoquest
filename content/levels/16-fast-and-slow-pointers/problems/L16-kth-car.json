  "title": "K-th Car From the End",
  "statement": "A parade is a linked list of cars, each with a number. Return the number on the k-th car from the end, in one pass.",
  "examples": [
    {
      "input": "head = [5, 8, 2, 9], k = 1",
      "output": "9"
    },
    {
      "input": "head = [5, 8, 2, 9], k = 4",
      "output": "5"
    }
  ],
  "constraints": [
    "1 <= k <= number of cars <= 100000"
  ],
  "answerKey": {
    "pattern": "Two pointers with a gap of k",
    "keyPoints": [
      "Move fast k nodes ahead",
      "Move both one node at a time until fast is null",
      "slow is the k-th from the end"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "k = 1: the last car",
      "k = length: the first car"
    ],
    "acceptableSlowerApproaches": [
      "Count the cars, then walk length − k nodes: two passes"
    ]
  },
  "hints": [
    "You cannot count backwards in a singly linked list. What if two pointers stay k apart?",
    "Move one pointer k nodes ahead first.",
    "Then move both until the front pointer runs off the end; the back pointer is the answer."
  ],
