  "order": 1,
  "title": "Middle Carriage",
  "statement": "A train is a linked list of carriages. Return the middle carriage. When there are two middle carriages, return the first of them.",
  "examples": [
    {
      "input": "head = [1, 2, 3, 4, 5]",
      "output": "[3, 4, 5]"
    },
    {
      "input": "head = [1, 2, 3, 4]",
      "output": "[2, 3, 4]"
    }
  ],
  "constraints": [
    "1 <= number of carriages <= 100000"
  ],
  "answerKey": {
    "pattern": "Fast and slow pointers",
    "keyPoints": [
      "slow moves one carriage, fast two",
      "Stop when fast cannot move two more (fast.next or fast.next.next is null)",
      "slow is then the first middle"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "One carriage",
      "Two carriages",
      "Even and odd lengths"
    ],
    "acceptableSlowerApproaches": [
      "Count, then walk half way: two passes",
      "Copy into an array: O(n) space"
    ]
  },
  "hints": [
    "Two pointers start at the head. How far has the slower one gone when the faster one reaches the end?",
    "Half as far. For the first middle of an even list, stop fast one step earlier.",
    "Loop while fast.next and fast.next.next exist: slow = slow.next, fast = fast.next.next."
  ],
  "starterCode": {
    "javascript": "function middleCarriage(head) {\n  // return the middle carriage (the first middle if there are two)\n}",
