{
  "id": "L16-repeated-badge",
  "level": 16,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 2,
  "title": "Repeated Badge",
  "statement": "A read-only list has n + 1 badge numbers, each between 1 and n, so some number repeats; exactly one number repeats (possibly more than twice). Return it without changing the list and with O(1) extra space.",
  "examples": [
    {
      "input": "badges = [1, 3, 4, 2, 2]",
      "output": "2"
    },
    {
      "input": "badges = [3, 1, 3, 4, 2]",
      "output": "3"
    }
  ],
  "constraints": [
    "2 <= n + 1 <= 100000",
    "1 <= badges[i] <= n",
    "Exactly one value repeats"
  ],
  "answerKey": {
    "pattern": "Floyd's cycle detection with values as next indexes",
    "keyPoints": [
      "Treat badges[i] as a pointer from index i to index badges[i]",
      "Index 0 is never pointed to, so start there",
      "Two indexes point to the repeated value, which makes it the start of a cycle",
      "Find the meeting point, then the cycle start: that index is the answer"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "The repeat appears many times",
      "n = 1",
      "The repeat is at the front or back"
    ],
    "acceptableSlowerApproaches": [
      "A hash set: O(n) space",
      "Sort a copy: O(n log n) time, O(n) space",
      "Binary search on the value with counting: O(n log n) time, O(1) space"
    ]
  },
  "hints": [
    "Think of each value as \"go to that index\". Where can you start that nothing points to?",
    "Index 0, because values are 1..n. Two indexes send you to the repeated value, so the path must loop.",
    "Run Floyd from index 0; the first node of the cycle is the repeated value."
  ],
  "starterCode": {
    "javascript": "function repeatedBadge(badges) {\n  // return the repeated number\n}",
    "java": "class Solution {\n  int repeatedBadge(int[] badges) {\n    // return the repeated number\n  }\n}"
  },
