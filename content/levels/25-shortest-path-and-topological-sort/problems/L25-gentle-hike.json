{
  "id": "L25-gentle-hike",
  "level": 25,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 2,
  "title": "Gentle Hike",
  "statement": "A hiking map gives the height of each cell. A hiker walks from the top-left cell to the bottom-right cell, moving up, down, left or right. The effort of a route is the largest height difference between two cells next to each other on it. Return the smallest possible effort.",
  "examples": [
    {
      "input": "heights = [[1, 2, 2], [3, 8, 2], [5, 3, 5]]",
      "output": "2"
    },
    {
      "input": "heights = [[1, 2, 3], [3, 8, 4], [5, 3, 5]]",
      "output": "1"
    }
  ],
  "constraints": [
    "1 <= rows, columns <= 100",
    "1 <= heights[r][c] <= 10^6"
  ],
  "answerKey": {
    "pattern": "Dijkstra where a route's cost is its largest step, not the sum",
    "keyPoints": [
      "effort[start] = 0",
      "Popping the cell with the smallest effort settles it",
      "Relax a neighbour with max(effort of current, height difference)"
    ],
    "timeComplexity": "O(rows · columns · log(rows · columns))",
    "spaceComplexity": "O(rows · columns)",
    "edgeCases": [
      "One cell: 0",
      "Flat map: 0",
      "A detour that avoids a cliff"
    ],
    "acceptableSlowerApproaches": [
      "Binary search on the effort with BFS: O(cells · log max), also good",
      "Union-find over edges sorted by difference: also good"
    ]
  },
  "hints": [
    "The cost of a route is its worst step. Does Dijkstra still work?",
    "Yes: extending a route never lowers its worst step, so the smallest one can be settled first.",
    "Use max(current effort, |height difference|) instead of a sum."
  ],
  "starterCode": {
    "javascript": "function gentleHike(heights) {\n  // return the smallest effort\n}",
    "java": "class Solution {\n  int gentleHike(int[][] heights) {\n    // return the smallest effort\n  }\n}"
  },
