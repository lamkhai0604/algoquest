  {
    "title": "The task",
    "body": "List every subset of **[1, 2, 3]**. Each level of the tree decides one number: the left branch **takes** it, the right branch **skips** it. A path from the top to the bottom is one subset. The tree is drawn as the search reaches each node.",
    "code": "function subsets(items) {\n  const result = [];\n  const path = [];\n  function explore(i) {\n    if (i === items.length) {\n      result.push([...path]);\n      return;\n    }\n    path.push(items[i]); // take\n    explore(i + 1);\n    path.pop(); // undo\n    explore(i + 1); // skip\n  }\n  explore(0);\n  return result;\n}",
