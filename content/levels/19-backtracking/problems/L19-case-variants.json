{
  "id": "L19-case-variants",
  "level": 19,
  "difficulty": "Easy",
  "use": "practice",
  "status": "ready",
  "order": 2,
  "title": "Case Variants",
  "statement": "A username can have each letter in upper or lower case; digits stay as they are. Given a username, return every case variant, sorted in ascending order (ordinary character order, where uppercase letters come before lowercase).",
  "examples": [
    {
      "input": "name = \"a1b\"",
      "output": "[\"A1B\", \"A1b\", \"a1B\", \"a1b\"]"
    },
    {
      "input": "name = \"3z\"",
      "output": "[\"3Z\", \"3z\"]"
    }
  ],
  "constraints": [
    "1 <= name.length <= 10",
    "Letters and digits only"
  ],
  "answerKey": {
    "pattern": "Backtracking: at each letter, branch on upper and lower case",
    "keyPoints": [
      "Walk the characters in order",
      "Digits have one option; letters have two",
      "Record when the whole string is built",
      "Sort the results"
    ],
    "timeComplexity": "O(n · 2^L)",
    "spaceComplexity": "O(n)",
    "edgeCases": [
      "No letters: one variant",
      "All letters",
      "Mixed case input"
    ],
    "acceptableSlowerApproaches": [
      "Iteratively double a list of partial strings at each letter: same cost"
    ]
  },
  "hints": [
    "How many choices does each character give?",
    "A letter gives two (upper, lower); a digit gives one.",
    "Recurse over the positions with a partial string; at the end, add it to the results; finally sort."
  ],
  "starterCode": {
    "javascript": "function caseVariants(name) {\n  // return the sorted variants\n}",
    "java": "class Solution {\n  String[] caseVariants(String name) {\n    // return the sorted variants\n  }\n}"
  },
