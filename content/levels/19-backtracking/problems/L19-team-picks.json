  "use": "test",
  "status": "ready",
  "title": "Team Picks",
  "statement": "A coach has n players with skill ratings and must pick exactly k of them. Return how many different teams have a total rating of at least minTotal.",
  "examples": [
    {
      "input": "ratings = [5, 3, 8, 1], k = 2, minTotal = 9",
      "output": "3"
    },
    {
      "input": "ratings = [1, 1], k = 2, minTotal = 3",
      "output": "0"
    }
  ],
  "constraints": [
    "1 <= k <= n <= 16",
    "1 <= ratings[i] <= 100"
  ],
  "answerKey": {
    "pattern": "Backtracking over combinations of size k",
    "keyPoints": [
      "Choose players with a start index so each team is built once",
      "Stop when k players are chosen and check the total",
      "Prune when too few players are left to reach k"
    ],
    "timeComplexity": "O(C(n, k) · k)",
    "spaceComplexity": "O(k)",
    "edgeCases": [
      "k = n",
      "k = 1",
      "No team reaches the minimum"
    ],
    "acceptableSlowerApproaches": [
      "Check every subset and keep those of size k: O(n · 2ⁿ)"
    ]
  },
  "hints": [
    "A team is a set: order does not matter. How do you build each set once?",
    "Choose players in increasing index order with a start index.",
    "Recurse with (start, chosen, total); at k chosen, count it if the total is high enough."
  ],
  "starterCode": {
    "javascript": "function teamPicks(ratings, k, minTotal) {\n  // return the number of teams\n}",
    "java": "class Solution {\n  int teamPicks(int[] ratings, int k, int minTotal) {\n    // return the number of teams\n  }\n}"
  },
