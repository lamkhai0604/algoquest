{
  "id": "L19-keypad-words",
  "level": 19,
  "difficulty": "Easy",
  "use": "practice",
  "status": "ready",
  "order": 3,
  "title": "Keypad Words",
  "statement": "On an old phone keypad, 2 = abc, 3 = def, 4 = ghi, 5 = jkl, 6 = mno, 7 = pqrs, 8 = tuv, 9 = wxyz. Given a string of digits 2–9, return every letter string it can spell, in alphabetical order. An empty input gives an empty list.",
  "examples": [
    {
      "input": "digits = \"23\"",
      "output": "[\"ad\", \"ae\", \"af\", \"bd\", \"be\", \"bf\", \"cd\", \"ce\", \"cf\"]"
    },
    {
      "input": "digits = \"\"",
      "output": "[]"
    }
  ],
  "constraints": [
    "0 <= digits.length <= 5",
    "digits has only 2–9"
  ],
  "answerKey": {
    "pattern": "Backtracking over each digit's letters",
    "keyPoints": [
      "Map digits to letters",
      "At position i, try every letter of digits[i]",
      "Record when the string is full",
      "Letters tried in order give alphabetical output"
    ],
    "timeComplexity": "O(4^n · n)",
    "spaceComplexity": "O(n)",
    "edgeCases": [
      "Empty input: []",
      "Digits 7 and 9 have 4 letters",
      "One digit"
    ],
    "acceptableSlowerApproaches": [
      "Build the list iteratively, digit by digit: same cost"
    ]
  },
  "hints": [
    "Each digit is one decision. How many options does it give?",
    "3 or 4 letters. Try each, go to the next digit, then undo.",
    "Recurse over the positions; when the path has as many letters as there are digits, record it."
  ],
  "starterCode": {
    "javascript": "function keypadWords(digits) {\n  // return every spelling, alphabetically\n}",
    "java": "class Solution {\n  String[] keypadWords(String digits) {\n    // return every spelling, alphabetically\n  }\n}"
  },
  "similarLeetCode": "Letter Combinations of a Phone Number",
