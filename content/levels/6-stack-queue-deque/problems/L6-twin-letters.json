  "title": "Pop the Twins",
  "statement": "In a word game, two equal letters standing next to each other pop and disappear, and the letters around them close the gap, which may make new twins pop. Keep going until no twins are left. Return the final string for `word`.",
  "examples": [
    {
      "input": "word = \"abbaca\"",
      "output": "\"ca\"",
      "explanation": "bb pops to give aaca, then aa pops to give ca"
    },
    {
      "input": "word = \"abc\"",
      "output": "\"abc\""
    }
  ],
  "constraints": [
    "1 <= word.length <= 10^5",
    "word has lowercase letters only"
  ],
  "answerKey": {
    "pattern": "Stack: a letter equal to the top pops it, otherwise it is pushed",
    "keyPoints": [
      "The only letter a new letter can pair with is the last one still standing",
      "If the stack's top equals the letter, pop; otherwise push",
      "Join the stack"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(n)",
    "edgeCases": [
      "Everything pops",
      "Nothing pops",
      "Three equal letters in a row: two pop, one stays"
    ],
    "acceptableSlowerApproaches": [
      "Search and remove pairs repeatedly: O(n^2)"
    ]
  },
  "hints": [
    "After some pops, which letter is the new letter next to?",
    "The last letter still standing is the top of a stack.",
    "Pop when the new letter equals the top, push otherwise, and join at the end."
  ],
