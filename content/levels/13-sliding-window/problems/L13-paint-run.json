  "status": "ready",
  "title": "Paint a Black Run",
  "statement": "A fence has boards painted white (W) or black (B). The painter wants k consecutive black boards. Return the fewest white boards she must repaint black to get such a run.",
  "examples": [
    {
      "input": "fence = \"WBBWWBBWBW\", k = 7",
      "output": "3"
    },
    {
      "input": "fence = \"WBWBBBW\", k = 2",
      "output": "0"
    }
  ],
  "constraints": [
    "1 <= k <= fence.length <= 100000",
    "fence has only 'W' and 'B'"
  ],
  "answerKey": {
    "pattern": "Fixed-size window counting whites",
    "keyPoints": [
      "Count the white boards in the first k boards",
      "Slide: update the count with the entering and leaving board",
      "The answer is the smallest white count of any window"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "k equals the fence length",
      "A run of k blacks already exists",
      "All boards white"
    ],
    "acceptableSlowerApproaches": [
      "Count each window from scratch: O(n · k)"
    ]
  },
  "hints": [
    "Every candidate run has exactly k boards. What must be repainted in a run?",
    "Its white boards. Find the k-board window with the fewest whites.",
    "Count whites in the first window, then slide, keeping the minimum."
  ],
  "starterCode": {
    "javascript": "function fewestRepaints(fence, k) {\n  // return the fewest white boards to repaint\n}",
    "java": "class Solution {\n  int fewestRepaints(String fence, int k) {\n    // return the fewest white boards to repaint\n  }\n}"
  },
