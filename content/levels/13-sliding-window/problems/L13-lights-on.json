{
  "id": "L13-lights-on",
  "level": 13,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 3,
  "title": "Lights On",
  "statement": "A hallway has a row of lights, 1 for on and 0 for off. An electrician can switch on at most k lights that are off. Return the length of the longest unbroken run of lit lights she can make.",
  "examples": [
    {
      "input": "lights = [1, 1, 0, 0, 1, 1, 1, 0, 1], k = 2",
      "output": "7"
    },
    {
      "input": "lights = [0, 0], k = 0",
      "output": "0"
    }
  ],
  "constraints": [
    "1 <= lights.length <= 100000",
    "lights[i] is 0 or 1",
    "0 <= k <= lights.length"
  ],
  "answerKey": {
    "pattern": "Variable-size window counting zeros: at most k zeros inside",
    "keyPoints": [
      "Count the off lights in the window",
      "Grow on the right",
      "While more than k off lights are inside, shrink from the left",
      "Record the longest window"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "k = 0",
      "k at least the number of off lights",
      "All lights on"
    ],
    "acceptableSlowerApproaches": [
      "Try every start and extend: O(n²)"
    ]
  },
  "hints": [
    "Switching on k lights means a run may contain at most k zeros. What do you keep track of?",
    "A window and the number of zeros inside it.",
    "Grow on the right; while zeros > k, remove lights[left] (lower the count if it was 0); record right − left + 1."
  ],
  "starterCode": {
    "javascript": "function longestLit(lights, k) {\n  // return the longest lit run\n}",
    "java": "class Solution {\n  int longestLit(int[] lights, int k) {\n    // return the longest lit run\n  }\n}"
  },
