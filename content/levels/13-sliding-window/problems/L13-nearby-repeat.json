  "id": "L13-nearby-repeat",
  "level": 13,
  "difficulty": "Easy",
  "use": "practice",
  "status": "ready",
  "order": 3,
  "title": "Repeat Visitor",
  "statement": "A museum logs the ticket number of each visitor in order. Return true if the same ticket number appears twice within k entries of each other (their positions differ by at most k), otherwise false.",
  "examples": [
    {
      "input": "tickets = [7, 3, 9, 3], k = 2",
      "output": "true"
    },
    {
      "input": "tickets = [5, 1, 2, 5], k = 2",
      "output": "false"
    }
  ],
  "constraints": [
    "1 <= tickets.length <= 100000",
    "0 <= k <= 100000"
  ],
  "answerKey": {
    "pattern": "Sliding window of the last k items in a hash set",
    "keyPoints": [
      "Keep a set of the last k ticket numbers",
      "Before adding a ticket, check whether it is in the set",
      "Remove the ticket that falls out of the window when the set passes k items"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(k)",
    "edgeCases": [
      "k = 0: no pair can count",
      "The repeat is exactly k apart",
      "Repeats far apart only"
    ],
    "acceptableSlowerApproaches": [
      "Check every pair within distance k: O(n · k)",
      "A hash map of last positions: also O(n)"
    ]
  },
  "hints": [
    "Only the last k tickets matter for the current one. Which structure answers \"have I seen it recently?\" in O(1)?",
    "A hash set holding the window of the last k tickets.",
    "For each ticket: if it is in the set, return true; add it; if the set holds more than k tickets, remove the one k places back."
  ],
  "starterCode": {
    "javascript": "function repeatVisitor(tickets, k) {\n  // return true or false\n}",
    "java": "class Solution {\n  boolean repeatVisitor(int[] tickets, int k) {\n    // return true or false\n  }\n}"
  },
