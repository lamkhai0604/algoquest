{
  "id": "L13-scrambled-word",
  "level": 13,
  "difficulty": "Medium",
  "use": "test",
  "status": "ready",
  "title": "Scrambled Word Finder",
  "statement": "A word game hides scrambled copies of a word in a long line of letters. Return, in increasing order, every start position in line where the next word.length letters are a rearrangement of word.",
  "examples": [
    {
      "input": "line = \"cbaebabacd\", word = \"abc\"",
      "output": "[0, 6]"
    },
    {
      "input": "line = \"abab\", word = \"ab\"",
      "output": "[0, 1, 2]"
    }
  ],
  "constraints": [
    "1 <= line.length, word.length <= 100000",
    "Both have lowercase letters only"
  ],
  "answerKey": {
    "pattern": "Fixed-size window with letter counts compared to the word's counts",
    "keyPoints": [
      "Count the word's letters",
      "Slide a window of word.length over line, updating its letter counts",
      "Keep a number of letters whose counts match, or compare the 26 counts",
      "Record the start when all counts match"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1): 26 letters",
    "edgeCases": [
      "word longer than line",
      "Overlapping matches",
      "No match"
    ],
    "acceptableSlowerApproaches": [
      "Sort each window and compare: O(n · m log m)"
    ]
  },
  "hints": [
    "A scrambled copy has the same letter counts as the word. How long is each window?",
    "A window of exactly word.length letters, slid one position at a time.",
    "Keep the window's 26 counts; after each slide, compare with the word's counts (or track how many letters match) and record the start."
  ],
  "starterCode": {
    "javascript": "function scrambledStarts(line, word) {\n  // return the start positions\n}",
    "java": "class Solution {\n  int[] scrambledStarts(String line, String word) {\n    // return the start positions\n  }\n}"
  },
