  "id": "L13-shortest-drive",
  "level": 13,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 1,
  "title": "Shortest Fundraising Drive",
  "statement": "A charity has the amount raised each day (never negative). Return the length of the shortest run of consecutive days that raised at least goal in total, or 0 if no run does.",
  "examples": [
    {
      "input": "raised = [2, 3, 1, 2, 4, 3], goal = 7",
      "output": "2"
    },
    {
      "input": "raised = [1, 1, 1], goal = 5",
      "output": "0"
    }
  ],
  "constraints": [
    "1 <= raised.length <= 100000",
    "0 <= raised[i] <= 10000",
    "1 <= goal <= 10^9"
  ],
  "answerKey": {
    "pattern": "Variable-size sliding window: shortest window that reaches a goal",
    "keyPoints": [
      "Grow the window on the right, adding to the sum",
      "While the sum reaches the goal, record the length and remove the left day",
      "Amounts are never negative, so shrinking only lowers the sum",
      "Return 0 if no window reached the goal"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "No run reaches the goal",
      "One day alone reaches it",
      "Days with 0"
    ],
    "acceptableSlowerApproaches": [
      "Prefix sums with binary search: O(n log n)",
      "Every start and end: O(n²)"
    ]
  },
  "hints": [
    "Once a run reaches the goal, can a shorter run ending at the same day also reach it?",
    "Grow on the right; when the sum reaches the goal, try to shrink from the left.",
    "While sum >= goal: record right − left + 1, subtract raised[left], move left. Keep the smallest length."
  ],
  "starterCode": {
    "javascript": "function shortestDrive(raised, goal) {\n  // return the shortest length, or 0\n}",
    "java": "class Solution {\n  int shortestDrive(int[] raised, int goal) {\n    // return the shortest length, or 0\n  }\n}"
  },
