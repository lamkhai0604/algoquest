  "order": 2,
  "title": "Pyramid of Blocks",
  "statement": "Stacking number blocks in a pyramid: the top row is `[1]`. Each new row starts and ends with 1, and every other block is the sum of the two blocks above it. Return row `k` (the top row is row 0). Build it recursively from row `k - 1`.",
  "examples": [
    {
      "input": "k = 3",
      "output": "[1, 3, 3, 1]"
    },
    {
      "input": "k = 0",
      "output": "[1]"
    }
  ],
  "constraints": [
    "0 <= k <= 33"
  ],
  "answerKey": {
    "pattern": "Recursion that builds the answer from the smaller case",
    "keyPoints": [
      "Base case: row 0 is [1]",
      "Get row k - 1 with one recursive call",
      "Row k starts with 1, has above[i - 1] + above[i] in the middle, and ends with 1",
      "One call per row: k calls in total"
    ],
    "timeComplexity": "O(k^2)",
    "spaceComplexity": "O(k^2) if every row is kept, O(k) for the call stack plus the current row",
    "edgeCases": [
      "k = 0",
      "k = 1",
      "The largest row (k = 33) still fits in a 32-bit integer"
    ],
    "acceptableSlowerApproaches": [
      "Compute each block separately with its own recursion: exponential time"
    ]
  },
  "hints": [
    "Which row can you write down without any work?",
    "If you already had row k - 1, how would you build row k from it?",
    "Call the function once for k - 1, then build the new row: 1, the pairwise sums, 1."
  ],
  "starterCode": {
    "javascript": "function pyramidRow(k) {\n  // return row k as an array\n}",
    "java": "class Solution {\n  int[] pyramidRow(int k) {\n    // return row k as an array\n  }\n}"
  },
