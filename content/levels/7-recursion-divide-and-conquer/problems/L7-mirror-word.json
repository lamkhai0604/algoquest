  "title": "Mirror Word",
  "statement": "A word puzzle asks whether a word of lowercase letters reads the same forwards and backwards. Use recursion: a word is a mirror word if its first and last letters match and the part between them is a mirror word. Return true or false.",
  "examples": [
    {
      "input": "word = \"racecar\"",
      "output": "true"
    },
    {
      "input": "word = \"rocket\"",
      "output": "false"
    }
  ],
  "constraints": [
    "0 <= word.length <= 2000",
    "Lowercase letters only"
  ],
  "answerKey": {
    "pattern": "Recursion on a shrinking range (two indices), base case of length 0 or 1",
    "keyPoints": [
      "Base case: a range of 0 or 1 letters is a mirror word",
      "If the outer letters differ, return false",
      "Otherwise recurse on the range one step in from each end",
      "Pass indices instead of slicing to avoid copying the string"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(n) for the call stack",
    "edgeCases": [
      "Empty word",
      "One letter",
      "Even and odd lengths"
    ],
    "acceptableSlowerApproaches": [
      "Slicing the string each call: O(n^2) because each slice copies",
      "A loop with two indices: same idea, O(1) space"
    ]
  },
  "hints": [
    "Which word is obviously a mirror word without checking anything?",
    "Compare the first and last letters. If they match, what is left to check?",
    "Recurse on indices (left + 1, right - 1) and stop when left >= right."
  ],
