{
  "id": "L7-out-of-order",
  "level": 7,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 3,
  "title": "Out-of-Order Pairs",
  "statement": "A music app ranks how shuffled a playlist is. `ratings` lists song ratings in play order. A pair of songs is out of order when an earlier song has a higher rating than a later one. Return how many such pairs there are. Aim for a solution that stays fast for 100,000 songs.",
  "examples": [
    {
      "input": "ratings = [3, 1, 2]",
      "output": "2",
      "explanation": "(3, 1) and (3, 2)"
    },
    {
      "input": "ratings = [1, 2, 3]",
      "output": "0"
    }
  ],
  "constraints": [
    "1 <= ratings.length <= 10^5",
    "0 <= ratings[i] <= 10^5",
    "Equal ratings are not out of order"
  ],
  "answerKey": {
    "pattern": "Divide and conquer: count while merge sorting",
    "keyPoints": [
      "Split the list in half; count pairs inside each half recursively",
      "Pairs across the halves are counted while merging the two sorted halves",
      "When an element from the right half is taken before the remaining left elements, each of those left elements forms an out-of-order pair with it",
      "Take from the left on ties, so equal ratings are not counted",
      "Total = left count + right count + cross count"
    ],
    "timeComplexity": "O(n log n)",
    "spaceComplexity": "O(n)",
    "edgeCases": [
      "Already sorted (0)",
      "Reverse sorted (n(n - 1)/2)",
      "Many equal ratings",
      "One song"
    ],
    "acceptableSlowerApproaches": [
      "Check every pair: O(n^2), too slow for 10^5 songs"
    ]
  },
  "hints": [
    "Split the playlist in half. Which pairs are inside the halves, and which cross between them?",
    "If both halves are sorted, the cross pairs can be counted during one merge.",
    "When you take a song from the right half, every song still waiting in the left half is higher: add how many are left."
  ],
  "starterCode": {
    "javascript": "function outOfOrder(ratings) {\n  // return the number of out-of-order pairs\n}",
    "java": "class Solution {\n  long outOfOrder(int[] ratings) {\n    // return the number of out-of-order pairs\n  }\n}"
  },
