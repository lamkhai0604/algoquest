{
  "id": "L11-light-table",
  "level": 11,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 1,
  "title": "Lit Windows Table",
  "statement": "For every number `i` from 0 to `n`, return how many 1 bits `i` has, as an array of length n + 1. Aim for O(n) total by reusing earlier answers instead of counting each number from scratch.",
  "examples": [
    {
      "input": "n = 5",
      "output": "[0, 1, 1, 2, 1, 2]"
    },
    {
      "input": "n = 0",
      "output": "[0]"
    }
  ],
  "constraints": [
    "0 <= n <= 10^5"
  ],
  "answerKey": {
    "pattern": "Reuse a smaller answer: bits[i] = bits[i >> 1] + (i & 1)",
    "keyPoints": [
      "i >> 1 is i without its last bit, and it is smaller than i, so its answer is already known",
      "Add 1 if the dropped last bit was 1",
      "Another rule: bits[i] = bits[i & (i - 1)] + 1"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(n) for the output",
    "edgeCases": [
      "n = 0",
      "Powers of two",
      "n = 1"
    ],
    "acceptableSlowerApproaches": [
      "Count the bits of each number separately: O(n log n)"
    ]
  },
  "hints": [
    "How does the binary form of i relate to the binary form of i >> 1?",
    "i >> 1 is i with the last bit removed. You already know its count.",
    "bits[i] = bits[i >> 1] + (i & 1)."
  ],
  "starterCode": {
    "javascript": "function lightTable(n) {\n  // return counts for 0..n\n}",
    "java": "class Solution {\n  int[] lightTable(int n) {\n    // return counts for 0..n\n  }\n}"
  },
