  "use": "practice",
  "status": "ready",
  "order": 2,
  "title": "Triplet Socks",
  "statement": "A sock factory packs socks in sets of three with the same label. In `labels`, every label appears exactly three times except one, which appears once. Return that label, using O(1) extra memory. XOR alone does not work here.",
  "examples": [
    {
      "input": "labels = [2, 2, 3, 2]",
      "output": "3"
    },
    {
      "input": "labels = [0, 1, 0, 1, 0, 1, 99]",
      "output": "99"
    }
  ],
  "constraints": [
    "1 <= labels.length <= 3 * 10^4",
    "0 <= label <= 2^31 - 1"
  ],
  "answerKey": {
    "pattern": "Count each bit position modulo 3",
    "keyPoints": [
      "For each of the 31 bit positions, count how many labels have a 1 there",
      "Labels that appear three times add a multiple of 3 to every count",
      "So count % 3 is the bit of the single label",
      "Build the answer from those bits"
    ],
    "timeComplexity": "O(31 n) = O(n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "A single label",
      "The single label is 0",
      "Large labels near 2^31 - 1"
    ],
    "acceptableSlowerApproaches": [
      "Count with a hash map: O(n) time, O(n) memory",
      "Sort and scan in steps of three: O(n log n)"
    ]
  },
  "hints": [
    "Look at one bit position across all labels. How many 1s come from labels that appear three times?",
    "A multiple of three. The remainder after dividing by 3 is the single label's bit.",
    "For bit b from 0 to 30: count labels with (x >> b) & 1, and if count % 3 is 1, set bit b in the answer."
  ],
  "starterCode": {
    "javascript": "function tripletSock(labels) {\n  // return the label that appears once\n}",
    "java": "class Solution {\n  int tripletSock(int[] labels) {\n    // return the label that appears once\n  }\n}"
  },
