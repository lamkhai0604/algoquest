  "level": 11,
  "difficulty": "Easy",
  "use": "practice",
  "status": "ready",
  "order": 3,
  "title": "The Odd Sock",
  "statement": "A laundry basket's socks are labelled with numbers. Every label appears on exactly two socks except one, which appears once. Return the label of that odd sock, using O(1) extra memory.",
  "examples": [
    {
      "input": "socks = [4, 1, 2, 1, 2]",
      "output": "4"
    },
    {
      "input": "socks = [7]",
      "output": "7"
    }
  ],
  "constraints": [
    "1 <= socks.length <= 3 * 10^4 (odd)",
    "0 <= label <= 10^5"
  ],
  "answerKey": {
    "pattern": "XOR all values: pairs cancel out",
    "keyPoints": [
      "x ^ x = 0 and x ^ 0 = x",
      "XOR is order-free (commutative and associative), so pairs cancel wherever they are",
      "XOR of everything leaves the value that appears once"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "A single sock",
      "Label 0",
      "The odd sock at either end"
    ],
    "acceptableSlowerApproaches": [
      "Count with a hash map: O(n) time but O(n) memory",
      "Sort and compare neighbours: O(n log n)"
    ]
  },
  "hints": [
    "What is x ^ x? What is x ^ 0?",
    "If you XOR all the labels together, what happens to each pair?",
    "Start with 0 and XOR every label into it; the result is the odd sock."
  ],
  "starterCode": {
    "javascript": "function oddSock(socks) {\n  // return the label that appears once\n}",
    "java": "class Solution {\n  int oddSock(int[] socks) {\n    // return the label that appears once\n  }\n}"
