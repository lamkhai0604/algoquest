{
  "id": "L11-topping-combos",
  "level": 11,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 3,
  "title": "Every Topping Combo",
  "statement": "A pizza place has toppings numbered in `toppings`. List every possible combination (including no toppings at all) using a bitmask: for mask from 0 to 2^n − 1, the combination holds `toppings[i]` when bit i of the mask is 1. Return the combinations in mask order, each listing its toppings in index order.",
  "examples": [
    {
      "input": "toppings = [1, 2]",
      "output": "[[], [1], [2], [1, 2]]"
    },
    {
      "input": "toppings = [5]",
      "output": "[[], [5]]"
    }
  ],
  "constraints": [
    "0 <= toppings.length <= 12",
    "Topping numbers are distinct"
  ],
  "answerKey": {
    "pattern": "Enumerate subsets with bitmasks from 0 to 2^n − 1",
    "keyPoints": [
      "There are 2^n combinations, one for each n-bit mask",
      "For each mask, include toppings[i] when (mask >> i) & 1 is 1",
      "Masks in increasing order give the required order"
    ],
    "timeComplexity": "O(n · 2^n)",
    "spaceComplexity": "O(n · 2^n) for the output",
    "edgeCases": [
      "No toppings: one empty combination",
      "One topping"
    ],
    "acceptableSlowerApproaches": [
      "Recursion that chooses include or skip for each topping (backtracking, Level 19), with a final sort into mask order"
    ]
  },
  "hints": [
    "How many combinations does a set of n toppings have?",
    "Each combination is a choice of yes or no per topping: an n-bit number.",
    "Loop mask from 0 to (1 << n) − 1 and add toppings[i] when bit i is set."
  ],
  "starterCode": {
    "javascript": "function toppingCombos(toppings) {\n  // return every combination in mask order\n}",
    "java": "class Solution {\n  List<List<Integer>> toppingCombos(int[] toppings) {\n    // return every combination in mask order\n  }\n}"
  },
