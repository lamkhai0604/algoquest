{
  "id": "L11-missing-seat",
  "level": 11,
  "difficulty": "Easy",
  "use": "test",
  "status": "ready",
  "title": "Missing Seat",
  "statement": "A theatre row has seats numbered 0 to n. The ticket scanner logged `seats`, which holds n different seat numbers in any order: every seat from 0 to n except one. Return the missing seat number, using O(1) extra memory.",
  "examples": [
    {
      "input": "seats = [3, 0, 1]",
      "output": "2"
    },
    {
      "input": "seats = [0, 1]",
      "output": "2"
    }
  ],
  "constraints": [
    "1 <= n = seats.length <= 10^4",
    "All numbers are distinct and between 0 and n"
  ],
  "answerKey": {
    "pattern": "XOR (or sum) of 0..n against the values: the difference is the missing one",
    "keyPoints": [
      "XOR every index 0..n and every value; each present number cancels with itself",
      "What is left is the missing number",
      "Alternative: n(n + 1) / 2 minus the sum of the values"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(1)",
    "edgeCases": [
      "The missing seat is 0",
      "The missing seat is n",
      "n = 1"
    ],
    "acceptableSlowerApproaches": [
      "A set of seen seats: O(n) memory",
      "Sort and scan: O(n log n)"
    ]
  },
  "hints": [
    "If no seat were missing, what would XOR (or the sum) of 0..n be?",
    "Combine all the numbers 0..n with all the values; present seats cancel out.",
    "Start x = n, then for each i: x ^= i ^ seats[i]."
  ],
  "starterCode": {
    "javascript": "function missingSeat(seats) {\n  // return the missing seat number\n}",
    "java": "class Solution {\n  int missingSeat(int[] seats) {\n    // return the missing seat number\n  }\n}"
  },
