{
  "id": "L8-shared-manager",
  "level": 8,
  "difficulty": "Medium",
  "use": "test",
  "status": "ready",
  "title": "Shared Manager",
  "statement": "Employee IDs are stored in a binary search tree with no repeated IDs. For two employees `p` and `q` (both in the tree), return the ID of their lowest shared manager: the deepest node that has both of them in its subtree. A node counts as being in its own subtree.",
  "examples": [
    {
      "input": "root = [6, 2, 8, 0, 4, 7, 9, null, null, 3, 5], p = 2, q = 8",
      "output": "6"
    },
    {
      "input": "root = [6, 2, 8, 0, 4, 7, 9, null, null, 3, 5], p = 2, q = 4",
      "output": "2"
    }
  ],
  "constraints": [
    "2 <= number of nodes <= 10^4",
    "p != q, and both are in the tree"
  ],
  "answerKey": {
    "pattern": "Walk down from the root using the BST order until p and q split",
    "keyPoints": [
      "If both p and q are smaller than the node, the answer is in the left subtree",
      "If both are larger, it is in the right subtree",
      "Otherwise they split here (or one of them is this node): this node is the answer",
      "Only one path from the root is walked"
    ],
    "timeComplexity": "O(h)",
    "spaceComplexity": "O(1) with a loop",
    "edgeCases": [
      "One of p, q is the root",
      "One is an ancestor of the other",
      "A chain-shaped tree"
    ],
    "acceptableSlowerApproaches": [
      "Record both root-to-node paths and find the last common node: O(h) time, O(h) space",
      "The general binary-tree method that searches both subtrees: O(n)"
    ]
  },
  "hints": [
    "Where are p and q compared with the root: both left, both right, or one on each side?",
    "If they are on the same side, move to that child and ask again.",
    "The first node where they are not on the same side (or that equals one of them) is the answer."
  ],
  "starterCode": {
    "javascript": "// A node is { val, left, right }. Make one with new TreeNode(val, left, right).\nfunction sharedManager(root, p, q) {\n  // return the ID of the lowest shared manager\n}",
    "java": "// TreeNode has: int val; TreeNode left, right; and new TreeNode(val).\nclass Solution {\n  int sharedManager(TreeNode root, int p, int q) {\n    // return the ID of the lowest shared manager\n  }\n}"
  },
