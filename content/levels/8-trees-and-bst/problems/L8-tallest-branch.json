  "order": 1,
  "title": "Tallest Branch",
  "statement": "A family tree app stores each family as a binary tree. Return the number of generations in the tree: the number of nodes on the longest path from the root down to a leaf. An empty tree has 0 generations.",
  "examples": [
    {
      "input": "root = [3, 9, 20, null, null, 15, 7]",
      "output": "3"
    },
    {
      "input": "root = [1, null, 2]",
      "output": "2"
    }
  ],
  "constraints": [
    "0 <= number of nodes <= 10^4",
    "Trees are written in level order; null marks a missing child"
  ],
  "answerKey": {
    "pattern": "Depth-first recursion: height = 1 + the taller child's height",
    "keyPoints": [
      "Base case: an empty tree has height 0",
      "Height of a node = 1 + max(height of left, height of right)",
      "Every node is visited once"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(h) for the recursion, where h is the height",
    "edgeCases": [
      "Empty tree",
      "A single node",
      "A tree that is one long chain"
    ],
    "acceptableSlowerApproaches": [
      "Level-order traversal with a queue, counting levels: same O(n)"
    ]
  },
  "hints": [
    "What is the height of an empty tree?",
    "If you knew the heights of the left and right subtrees, what is the height of the whole tree?",
    "Return 1 + Math.max(height(left), height(right)), with 0 for null."
  ],
  "starterCode": {
    "javascript": "// A node is { val, left, right }. Make one with new TreeNode(val, left, right).\nfunction tallestBranch(root) {\n  // return the number of levels\n}",
    "java": "// TreeNode has: int val; TreeNode left, right; and new TreeNode(val).\nclass Solution {\n  int tallestBranch(TreeNode root) {\n    // return the number of levels\n  }\n}"
  },
