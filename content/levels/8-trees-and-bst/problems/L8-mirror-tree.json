  "order": 2,
  "title": "Mirror the Tree",
  "statement": "A drawing app flips a tree diagram left to right. Swap the left and right children of every node, in place, and return the root.",
  "examples": [
    {
      "input": "root = [4, 2, 7, 1, 3, 6, 9]",
      "output": "[4, 7, 2, 9, 6, 3, 1]"
    },
    {
      "input": "root = [1, null, 2]",
      "output": "[1, 2]"
    }
  ],
  "constraints": [
    "0 <= number of nodes <= 100",
    "Trees are written in level order; null marks a missing child"
  ],
  "answerKey": {
    "pattern": "Recursion: mirror both subtrees, then swap them",
    "keyPoints": [
      "Base case: an empty tree stays empty",
      "Mirror the left and right subtrees recursively",
      "Swap root.left and root.right",
      "Return the root"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(h) for the recursion",
    "edgeCases": [
      "Empty tree",
      "One node",
      "Only one child at some nodes"
    ],
    "acceptableSlowerApproaches": [
      "A queue that visits every node and swaps its children: same O(n)"
    ]
  },
  "hints": [
    "What does the mirror of a single node look like?",
    "After flipping, the left subtree is the mirror of the old right subtree, and the other way round.",
    "Mirror both children recursively, swap them, and return the node."
  ],
  "starterCode": {
    "javascript": "// A node is { val, left, right }. Make one with new TreeNode(val, left, right).\nfunction mirrorTree(root) {\n  // return the root of the mirrored tree\n}",
    "java": "// TreeNode has: int val; TreeNode left, right; and new TreeNode(val).\nclass Solution {\n  TreeNode mirrorTree(TreeNode root) {\n    // return the root of the mirrored tree\n  }\n}"
  },
