{
  "id": "L8-price-range",
  "level": 8,
  "difficulty": "Easy",
  "use": "practice",
  "status": "ready",
  "order": 3,
  "title": "Total in a Price Range",
  "statement": "A shop keeps its item prices in a binary search tree: every price in a node's left subtree is smaller, and every price in its right subtree is larger. All prices are different. Return the sum of all prices from `low` to `high`, inclusive. Use the tree's order to skip branches that cannot contain such prices.",
  "examples": [
    {
      "input": "root = [10, 5, 15, 3, 7, null, 18], low = 7, high = 15",
      "output": "32",
      "explanation": "7 + 10 + 15"
    },
    {
      "input": "root = [10, 5, 15], low = 20, high = 30",
      "output": "0"
    }
  ],
  "constraints": [
    "0 <= number of nodes <= 2 * 10^4",
    "1 <= prices, low, high <= 10^5",
    "low <= high"
  ],
  "answerKey": {
    "pattern": "BST pruning: only go left when the value is above low, only go right when it is below high",
    "keyPoints": [
      "If the node's price is in range, add it",
      "If the price is greater than low, the left subtree may hold prices in range: visit it",
      "If the price is less than high, the right subtree may hold prices in range: visit it",
      "Skipped branches save work"
    ],
    "timeComplexity": "O(n) in the worst case, often much less",
    "spaceComplexity": "O(h)",
    "edgeCases": [
      "Empty tree",
      "No price in range",
      "low and high equal to prices in the tree"
    ],
    "acceptableSlowerApproaches": [
      "Visit every node and check the range: O(n), ignores the BST order"
    ]
  },
  "hints": [
    "If a node's price is below low, can anything in its left subtree be in range?",
    "Visit the left child only when the price is greater than low, the right child only when it is less than high.",
    "Add the node's price when low <= price <= high, plus the sums from the children you visit."
  ],
  "starterCode": {
    "javascript": "// A node is { val, left, right }. Make one with new TreeNode(val, left, right).\nfunction rangeTotal(root, low, high) {\n  // return the sum of prices in [low, high]\n}",
    "java": "// TreeNode has: int val; TreeNode left, right; and new TreeNode(val).\nclass Solution {\n  int rangeTotal(TreeNode root, int low, int high) {\n    // return the sum of prices in [low, high]\n  }\n}"
  },
