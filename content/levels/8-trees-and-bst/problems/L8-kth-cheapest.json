{
  "id": "L8-kth-cheapest",
  "level": 8,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 3,
  "title": "K-th Cheapest Ticket",
  "statement": "A ticket site keeps seat prices in a binary search tree with no repeated prices. Return the `k`-th cheapest price (k = 1 is the cheapest). Stop as soon as you have found it.",
  "examples": [
    {
      "input": "root = [5, 3, 6, 2, 4, null, null, 1], k = 3",
      "output": "3"
    },
    {
      "input": "root = [3, 1, 4, null, 2], k = 1",
      "output": "1"
    }
  ],
  "constraints": [
    "1 <= k <= number of nodes <= 10^4",
    "Prices are distinct"
  ],
  "answerKey": {
    "pattern": "In-order traversal of a BST visits values in increasing order; count and stop at k",
    "keyPoints": [
      "In-order (left, node, right) visits a BST from smallest to largest",
      "Count nodes as they are visited; the k-th visited is the answer",
      "Stop early once found (return early, or use an explicit stack)"
    ],
    "timeComplexity": "O(h + k)",
    "spaceComplexity": "O(h)",
    "edgeCases": [
      "k = 1 (leftmost node)",
      "k = number of nodes (rightmost)",
      "A tree that is one long chain"
    ],
    "acceptableSlowerApproaches": [
      "Collect every value in order, then index k - 1: O(n) time and space"
    ]
  },
  "hints": [
    "In which order would you visit a BST to see prices from cheapest to most expensive?",
    "In-order: left subtree, node, right subtree. Count each node you visit.",
    "When the count reaches k, record the price and stop going further."
  ],
  "starterCode": {
    "javascript": "// A node is { val, left, right }. Make one with new TreeNode(val, left, right).\nfunction kthCheapest(root, k) {\n  // return the k-th smallest price\n}",
