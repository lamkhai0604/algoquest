  "use": "test",
  "status": "ready",
  "title": "Nearest Exit",
  "statement": "A maze game is a binary tree: you start at the root, and a leaf (a node with no children) is an exit. Return the number of nodes on the shortest path from the root to any exit, counting both ends. An empty tree returns 0.",
  "examples": [
    {
      "input": "root = [3, 9, 20, null, null, 15, 7]",
      "output": "2"
    },
    {
      "input": "root = [2, null, 3, null, 4]",
      "output": "3"
    }
  ],
  "constraints": [
    "0 <= number of nodes <= 10^4"
  ],
  "answerKey": {
    "pattern": "Breadth-first search that stops at the first leaf (or recursion that handles one-child nodes)",
    "keyPoints": [
      "A node with one child is not an exit: its depth comes from the child that exists",
      "BFS level by level finds the nearest leaf first and can stop there",
      "Recursive version: if one child is missing, use the other child's depth; otherwise take the smaller"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(w) for BFS, O(h) for recursion",
    "edgeCases": [
      "Empty tree",
      "A single node",
      "A chain where every node has one child"
    ],
    "acceptableSlowerApproaches": []
  },
  "hints": [
    "Is a node with only one child an exit?",
    "Search level by level from the root; the first leaf you meet is the nearest.",
    "Or recurse, but when one child is null, only the other child's depth counts."
  ],
  "starterCode": {
    "javascript": "// A node is { val, left, right }. Make one with new TreeNode(val, left, right).\nfunction nearestExit(root) {\n  // return the number of nodes on the shortest root-to-leaf path\n}",
