{
  "id": "L8-valid-catalog",
  "level": 8,
  "difficulty": "Medium",
  "use": "practice",
  "status": "ready",
  "order": 2,
  "title": "Check the Catalog Tree",
  "statement": "A library catalog should be a binary search tree: for every node, all values in its left subtree are smaller and all values in its right subtree are larger (no repeats). A volunteer edited the tree by hand. Return true if it is still a valid binary search tree.",
  "examples": [
    {
      "input": "root = [5, 3, 8, 1, 4, 7, 9]",
      "output": "true"
    },
    {
      "input": "root = [5, 3, 8, 1, 6]",
      "output": "false",
      "explanation": "6 is in the left subtree of 5 but is larger than 5"
    }
  ],
  "constraints": [
    "0 <= number of nodes <= 10^4",
    "-2^31 <= node value <= 2^31 - 1"
  ],
  "answerKey": {
    "pattern": "Recursion with an allowed (low, high) range passed down",
    "keyPoints": [
      "Checking only a node against its children is not enough: the rule is about whole subtrees",
      "Pass down the range a node's value must be in, starting unbounded",
      "Going left, the upper bound becomes the node's value; going right, the lower bound does",
      "A value equal to a bound breaks the rule",
      "An in-order traversal must also be strictly increasing, which is another valid check"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(h)",
    "edgeCases": [
      "Empty tree (valid)",
      "A node deep in a subtree breaking an ancestor's bound",
      "Equal values",
      "Values at the 32-bit limits"
    ],
    "acceptableSlowerApproaches": [
      "Collect the in-order values in an array and check they increase: O(n) time, O(n) space"
    ]
  },
  "hints": [
    "Is it enough to compare each node with its two children?",
    "Every node has a range it must fall in, set by its ancestors.",
    "Recurse with (low, high): left child gets (low, node.val), right child gets (node.val, high)."
  ],
  "starterCode": {
    "javascript": "// A node is { val, left, right }. Make one with new TreeNode(val, left, right).\nfunction isValidCatalog(root) {\n  // return true or false\n}",
    "java": "// TreeNode has: int val; TreeNode left, right; and new TreeNode(val).\nclass Solution {\n  boolean isValidCatalog(TreeNode root) {\n    // return true or false\n  }\n}"
  },
  "similarLeetCode": "Validate Binary Search Tree",
