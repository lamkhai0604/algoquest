  "use": "practice",
  "status": "ready",
  "order": 1,
  "title": "Floor by Floor",
  "statement": "A company's org chart is a binary tree. To print it floor by floor, return the values level by level: a list of levels from the root down, each level listed from left to right.",
  "examples": [
    {
      "input": "root = [3, 9, 20, null, null, 15, 7]",
      "output": "[[3], [9, 20], [15, 7]]"
    },
    {
      "input": "root = []",
      "output": "[]"
    }
  ],
  "constraints": [
    "0 <= number of nodes <= 2000",
    "Trees are written in level order; null marks a missing child"
  ],
  "answerKey": {
    "pattern": "Level-order traversal (breadth-first) with a queue, one level per round",
    "keyPoints": [
      "Start the queue with the root",
      "At the start of each round, the queue holds exactly one level: remember its size",
      "Take that many nodes, record their values, and add their children to the queue",
      "Each round produces one level"
    ],
    "timeComplexity": "O(n)",
    "spaceComplexity": "O(w), the widest level",
    "edgeCases": [
      "Empty tree",
      "One node",
      "A chain leaning to one side"
    ],
    "acceptableSlowerApproaches": [
      "Depth-first search that passes the depth and appends to levels[depth]: also O(n)"
    ]
  },
  "hints": [
    "Which structure gives nodes in the order they were found: first in, first out?",
    "Use a queue. How do you know where one level ends and the next begins?",
    "Read the queue's size at the start of each round; process exactly that many nodes for this level."
  ],
  "starterCode": {
    "javascript": "// A node is { val, left, right }. Make one with new TreeNode(val, left, right).\nfunction floorByFloor(root) {\n  // return an array of levels\n}",
