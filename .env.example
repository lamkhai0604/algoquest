# Copy to .env (git-ignored) and fill in values. Never commit .env or paste its values anywhere.
# The backend reads this file from the repository root; docker compose reads it too.

# Database. Local default matches docker-compose.yml. For Neon use a JDBC URL:
# jdbc:postgresql://<host>/<database>?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/algoquest
DATABASE_USERNAME=algoquest
DATABASE_PASSWORD=algoquest

# The account with this email becomes the first Owner (FR-17).
OWNER_EMAIL=

# Sign-in (T-104). Google Cloud OAuth client and GitHub OAuth App "AlgoQuest (local)".
# Replace "not-configured" with your values; the app starts without them, but sign-in fails.
GOOGLE_CLIENT_ID=not-configured
GOOGLE_CLIENT_SECRET=not-configured
GITHUB_CLIENT_ID=not-configured
GITHUB_CLIENT_SECRET=not-configured

# Signs the app's own login tokens. Any random string of at least 32 characters.
JWT_SECRET=

# Address of the frontend, used for sign-in redirects and CORS.
FRONTEND_URL=http://localhost:5173

# AI grading. Without a key the app starts, but grading answers "unavailable".
# GRADING_PROVIDER=fake uses fixed rules instead of Gemini (no key needed; for trying the pages).
GEMINI_API_KEY=
GRADING_PROVIDER=gemini

# Java code runs on Judge0 (RapidAPI key). Without it, Java runs answer "unavailable";
# JavaScript still works. JAVA_RUNNER=fake runs without a key (fixed rules, for local tries).
JUDGE0_API_KEY=
JAVA_RUNNER=judge0
